---
import { url } from "../utils/url";
import Icon from "./Icon.astro";
import cv from "../data/cv.json";

// 'a' borderless glow (default) | 'b' vertical rail | 'c' index list.  Change here to switch.
const variant = (process.env.HERO_VARIANT ?? 'a') as 'a' | 'b' | 'c';
const n = cv.ncell;
const sw = `${n.swappedSites}${n.plus ? '+' : ''}`;
const stat = { label: 'Ncell Network Modernization', value: sw, text: `Project controller for several clusters in the Ncell modernisation, which moved ${n.totalSites} Kathmandu BTS sites to Huawei equipment. Swapped ${sw} sites to live on-air in a single night (${n.year}).` };
const slides = [
  { kind: 'Career highlight', icon: 'chart', title: stat.label, short: `Ncell: ${stat.value} sites in one night`, big: stat.value, text: stat.text },
  ...cv.recognition.map((r) => ({ kind: 'Recognition', icon: r.icon, title: r.title, short: r.title, big: '', text: r.text })),
];
---

<section class="hero">
  <svg class="rings" viewBox="0 0 800 600" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <g fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1">
      <circle cx="640" cy="300" r="180" /><circle cx="640" cy="300" r="260" /><circle cx="640" cy="300" r="340" /><circle cx="640" cy="300" r="420" />
    </g>
  </svg>

  <div class="site-container hero-grid">
    <div class="copy">
      <p class="eyebrow">MIS <i>•</i> Project Control <i>•</i> Business Operations</p>
      <h1>Turning information into<br /><span>clarity.</span></h1>
      <p class="lede">
        Engineer by background. Business professional by experience. <br class="lg" />
        I help teams and businesses make sense of data, streamline processes and deliver results.
      </p>

      <ul class="meta">
        <li><Icon name="pin" size={18} /> Kathmandu, Nepal</li>
        <li><Icon name="briefcase" size={18} /> 6+ Years Corporate Experience</li>
        <li><Icon name="cap" size={18} />BE, EMBA</li>
      </ul>

      <div class="actions">
        <a href={url("/cv")} class="btn-hero primary">View my CV <Icon name="download" size={16} /></a>
        <a href={url("/contact")} class="btn-hero ghost">Contact me <Icon name="arrow" size={16} /></a>
      </div>
    </div>

    <div class="photo">
      <img
        src={url("/images/saroj-cutout.webp")}
        alt="Portrait of Saroj Baral in a navy blazer and white shirt"
        width="900"
        height="1117"
        fetchpriority="high"
      />
      <aside class={`recog v-${variant}`} role="group" aria-roledescription="carousel" aria-label="Career highlights and recognition">
        <span class="glow" aria-hidden="true"></span>
        {variant === 'c' && (
          <ol class="index">
            {slides.map((s, i) => (
              <li><button type="button" data-i={i} class={i === 0 ? 'on' : ''} aria-label={`Show ${s.title}`}><i></i>{s.short}</button></li>
            ))}
          </ol>
        )}
        <div class="slides">
          {slides.map((s, i) => (
            <div class={`slide${i === 0 ? ' on' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
              {variant !== 'c' && <p class="kind"><Icon name={s.icon} size={16} stroke={1.5} />{s.kind}</p>}
              {s.big && variant !== 'c' && <p class="big">{s.big}</p>}
              {variant !== 'c' && <p class="label">{s.title}</p>}
              <p class="small">{s.text}</p>
            </div>
          ))}
        </div>
        {variant !== 'c' && (
          <div class={variant === 'b' ? 'rail' : 'dots'}>
            {slides.map((s, i) => (
              <button type="button" class={i === 0 ? 'on' : ''} aria-label={`Show ${s.title}`} data-i={i}></button>
            ))}
          </div>
        )}
        <button type="button" class="pause" aria-label="Pause slideshow" data-state="playing"><span class="bars"></span></button>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; color: #fff;
    background:
      radial-gradient(55% 85% at 78% 38%, #55585F 0%, #2B2E36 40%, rgba(20, 22, 29, 0) 75%),
      linear-gradient(100deg, #050B18 0%, #07112A 52%, #15171E 100%);
  }
  .rings { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero { --gx: clamp(16px, 5vw, 24px); }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
  @media (max-width: 767px) { .hero-grid { padding-inline: var(--gx); } }
  .copy { padding: 56px 0 24px; z-index: 2; }
  .hero { padding-bottom: 28px; }

  .eyebrow { color: var(--blue-bright); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 22px; }
  .eyebrow i { font-style: normal; margin: 0 6px; opacity: 0.9; }
  h1 { color: #fff; font-size: clamp(2.4rem, 3.7vw, 3.55rem); line-height: 1.1; letter-spacing: -0.035em; font-weight: 700; margin: 0 0 24px; }
  h1 span { color: var(--blue-bright); }
  .lede { font-size: 1.08rem; line-height: 1.7; color: #D8DFEC; max-width: 34rem; margin: 0 0 26px; }
  .lg { display: none; }

  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 14px 30px; padding: 0; margin: 0 0 30px; font-size: 14.5px; color: #E3E8F3; }
  .meta li { display: inline-flex; align-items: center; gap: 9px; }
  .meta :global(svg) { color: var(--blue-bright); }

  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn-hero {
    display: inline-flex; align-items: center; gap: 12px; text-decoration: none;
    font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 14px 22px; border-radius: 3px; transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-hero.primary { background: var(--btn-bg); color: #fff; border: 1px solid var(--btn-bg); }
  .btn-hero.primary:hover { background: var(--btn-bg-hover); border-color: var(--btn-bg-hover); }
  .btn-hero.ghost { color: #fff; border: 1px solid rgba(255, 255, 255, 0.45); }
  .btn-hero.ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.08); }

  /* Mobile: portrait runs edge to edge and fades into the page at the bottom */
  .photo { position: relative; display: flex; flex-direction: column; align-items: stretch; margin: 8px calc(-1 * var(--gx)) 0; }
  .photo img { display: block; width: 100%; max-width: 460px; height: auto; margin-inline: auto; filter: saturate(0.92) contrast(1.03);
    -webkit-mask-image: linear-gradient(to bottom, #000 68%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 68%, transparent 100%); }
  /* ---- Recognition block: borderless, no card ---- */
  .recog { position: relative; margin: -24px 0 28px; width: 100%; max-width: 360px; padding: 8px var(--gx) 0; isolation: isolate; }
  .glow { position: absolute; z-index: -1; inset: -70px -80px -50px -80px; pointer-events: none;
    background: radial-gradient(closest-side, rgba(66, 120, 235, 0.30), rgba(66, 120, 235, 0.11) 55%, transparent 100%); filter: blur(10px); }
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(5px); transition: opacity 0.9s ease, transform 0.9s ease, visibility 0s linear 0.9s; }
  .slide.on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.9s ease, transform 0.9s ease; }
  .kind { display: flex; align-items: center; gap: 9px; margin: 0 0 12px; font-size: 11px; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; color: #8DBBFF; }
  .kind :global(svg) { color: #8DBBFF; }
  .big { font-size: 2.5rem; font-weight: 300; line-height: 1; letter-spacing: -0.03em; margin: 0 0 8px; color: #fff; }
  .label { font-size: 15px; font-weight: 500; line-height: 1.35; letter-spacing: 0.005em; margin: 0 0 6px; color: #EEF2FA; }
  .small { font-size: 13px; line-height: 1.65; letter-spacing: 0.01em; margin: 0; color: rgba(214, 223, 241, 0.78); max-width: 27ch; }

  .dots { display: flex; gap: 4px; margin-top: 16px; }
  .dots button { width: 26px; height: 18px; padding: 0; border: 0; background: transparent; cursor: pointer; position: relative; }
  .dots button::after { content: ""; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; border-radius: 2px; background: rgba(255, 255, 255, 0.22); transition: background 0.4s; }
  .dots button.on::after { background: #6EA2FF; }
  .dots button:hover::after { background: rgba(255, 255, 255, 0.55); }
  .dots button.on:hover::after { background: #8DBBFF; }
  .pause { position: absolute; right: 0; bottom: -3px; width: 24px; height: 24px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; opacity: 0.55; transition: opacity 0.2s; display: inline-flex; align-items: center; justify-content: center; }
  .pause:hover, .recog:hover .pause { opacity: 1; }
  .bars { width: 8px; height: 9px; border-left: 2px solid #D8E4FA; border-right: 2px solid #D8E4FA; box-sizing: border-box; }
  .pause[data-state="paused"] .bars { border: 0; border-left: 7px solid #D8E4FA; border-top: 5px solid transparent; border-bottom: 5px solid transparent; width: 0; height: 0; margin-left: 2px; }
  .dots button:focus-visible, .pause:focus-visible, .rail button:focus-visible, .index button:focus-visible { outline: 2px solid #9FC2FF; outline-offset: 2px; }

  /* Variant B: vertical rail + atmospheric side glow */
  .v-b { padding: 4px 0 4px 30px; }
  .v-b .glow { inset: -60px -90px -60px -40px; background: linear-gradient(90deg, rgba(66, 120, 235, 0.0), rgba(66, 120, 235, 0.16) 30%, rgba(66, 120, 235, 0.0) 100%); filter: blur(14px); }
  .v-b .rail { position: absolute; left: 0; top: 4px; bottom: 4px; display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; margin: 0; }
  .v-b .rail::before { content: ""; position: absolute; left: 4px; top: 6px; bottom: 6px; width: 1px; background: linear-gradient(180deg, rgba(141,187,255,0), rgba(141,187,255,0.55) 20%, rgba(141,187,255,0.55) 80%, rgba(141,187,255,0)); }
  .rail button { position: relative; width: 20px; height: 20px; padding: 0; border: 0; background: transparent; cursor: pointer; }
  .rail button::after { content: ""; position: absolute; left: 1px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: #0B1633; border: 1px solid rgba(141,187,255,0.6); transition: all 0.4s ease; }
  .rail button.on::after { background: #6EA2FF; border-color: #BCD6FF; box-shadow: 0 0 0 4px rgba(110,162,255,0.18), 0 0 14px rgba(110,162,255,0.6); }
  .rail button:hover::after { border-color: #fff; }
  .v-b .slide { min-height: 150px; }
  .v-b .pause { right: -2px; bottom: -10px; }

  /* Variant C: quiet index; the active line lights up, the rest recede */
  .v-c { width: min(100%, 290px); }
  .v-c .glow { inset: -60px -80px -40px -60px; }
  .index { list-style: none; margin: 0 0 14px; padding: 0; }
  .index button { display: flex; align-items: center; gap: 12px; width: 100%; padding: 5px 0; background: transparent; border: 0; cursor: pointer; text-align: left;
    font: inherit; font-size: 13.5px; letter-spacing: 0.01em; color: rgba(214, 223, 241, 0.45); transition: color 0.5s ease, letter-spacing 0.5s ease; }
  .index button i { width: 10px; height: 1px; background: currentColor; transition: width 0.5s ease, background 0.5s ease; flex: none; }
  .index button:hover { color: rgba(238, 242, 250, 0.8); }
  .index button.on { color: #fff; font-weight: 500; letter-spacing: 0.02em; }
  .index button.on i { width: 26px; background: #6EA2FF; }
  .v-c .slide { min-height: 48px; padding-left: 38px; }
  .v-c .small { font-size: 12.5px; max-width: 26ch; }
  .v-c .pause { right: -4px; top: -6px; bottom: auto; }

  @media (prefers-reduced-motion: reduce) { .slide, .slide.on { transition: none; transform: none; } .pause { display: none; } }

  /* Large phones: compact hero, headline left and portrait right, details below (below 360px stays one column) */
  @media (min-width: 360px) and (max-width: 767px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); align-items: end; }
    .copy, .photo { display: contents; }
    .eyebrow { grid-column: 1 / -1; grid-row: 1; margin: 26px 0 12px; font-size: 12px; }
    h1 { grid-column: 1; grid-row: 2; align-self: center; font-size: 2.05rem; margin: 0 0 20px; position: relative; z-index: 2; }
    .photo img { grid-column: 2; grid-row: 2; width: calc(100% + var(--gx)); max-width: none; margin: 0 calc(-1 * var(--gx)) 0 0; align-self: end;
      -webkit-mask-image: linear-gradient(to bottom, #000 80%, transparent 100%); mask-image: linear-gradient(to bottom, #000 80%, transparent 100%); }
    .lede { grid-column: 1 / -1; grid-row: 3; margin: 8px 0 18px; font-size: 1rem; position: relative; z-index: 2; }
    .meta { grid-column: 1 / -1; grid-row: 4; margin: 0 0 22px; }
    .actions { grid-column: 1 / -1; grid-row: 5; margin-bottom: 10px; }
    .recog { grid-column: 1 / -1; grid-row: 6; margin: 12px 0 28px; max-width: none; padding-inline: 0; }
  }

  /* Tablet: two columns, copy left, portrait right */
  @media (min-width: 768px) and (max-width: 1199px) {
    .hero-grid { grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr); column-gap: 24px; align-items: end; }
    .copy { padding: 64px 0 36px; }
    .photo { margin: 0; }
    .photo img { max-width: 440px; margin: 0 0 0 auto; }
    .recog { padding: 8px 0 0; max-width: 340px; margin-left: auto; }
    .hero { padding-bottom: 8px; }
  }

  @media (min-width: 1200px) {
    .lg { display: inline; }
    .hero { min-height: 570px; }
    .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); min-height: 570px; }
    .copy { padding: 72px 0 92px; }
    .photo { position: static; display: block; margin: 0; }
    .photo img {
      position: absolute; right: max(-30px, calc((100vw - 1320px) / 2 + 20px)); bottom: 0;
      height: 104%; width: auto; max-width: none; margin: 0;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 88%, transparent 100%);
    }
    .recog { position: absolute; margin: 0; width: 226px; padding: 0; left: calc(50% - 6px); bottom: 150px; z-index: 3; }
    .v-b { padding-left: 28px; width: 250px; }
    .v-c { width: 244px; }
  }
  @media (min-width: 1280px) { .recog { left: calc(50% + 10px); } }
</style>

<script>
  const root = document.querySelector('.hero .recog');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-i]'));
    const pauseBtn = root.querySelector<HTMLButtonElement>('.pause')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DWELL = 6000;
    let i = 0, timer: number | undefined, userPaused = false, hovering = false;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const play = () => { stop(); if (!reduce && !userPaused && !hovering) timer = window.setInterval(() => show(i + 1), DWELL); };

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.i)); play(); }));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.dataset.state = userPaused ? 'paused' : 'playing';
      pauseBtn.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
      play();
    });
    root.addEventListener('mouseenter', () => { hovering = true; stop(); });
    root.addEventListener('mouseleave', () => { hovering = false; play(); });
    root.addEventListener('focusin', () => { hovering = true; stop(); });
    root.addEventListener('focusout', () => { hovering = false; play(); });
    play();
  }
</script>
