---
import { url } from "../utils/url";
import Icon from "./Icon.astro";

interface Props {
  name: string;
  price: string;
  featured?: boolean;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  name,
  price,
  featured = false,
  features = [],
  ctaText = 'Request a quote',
  ctaHref = '/contact?service=website',
} = Astro.props;
---

<div
  class={`card-base card-hover relative p-6 md:p-7 flex flex-col justify-between h-full ${
    featured ? 'border-[var(--color-accent)] shadow-[var(--shadow-md)]' : ''
  }`}
  style={featured ? 'border-width:2px' : undefined}
>
  {featured && (
    <span class="tag tag--accent absolute -top-3 left-6 font-bold shadow-sm" style="background:var(--color-btn);color:#fff">
      Most popular
    </span>
  )}

  <div>
    <h3 class="text-xl font-semibold mb-3">{name}</h3>

    <div class="mb-6 pb-6 border-b border-[var(--color-border)]">
      <div class="text-3xl font-bold tracking-tight">{price}</div>
      <span class="text-xs text-[var(--color-muted)]">Fixed quote · 7–10 days turnaround</span>
    </div>

    <ul class="space-y-3 mb-8 text-[15px] list-none p-0">
      {features.map((feature) => (
        <li class="flex items-start gap-2.5">
          <Icon name="check" size={16} strokeWidth={2.5} class="mt-1 shrink-0 text-[var(--color-accent)]" />
          <span class="text-[var(--color-text)]">{feature}</span>
        </li>
      ))}
    </ul>
  </div>

  <a href={url(ctaHref)} class={`btn-base w-full ${featured ? 'btn-primary' : 'btn-secondary'}`}>
    {ctaText}
    <Icon name="arrow-right" size={16} />
  </a>
</div>
