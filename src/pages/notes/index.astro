---
import { url } from "../../utils/url";
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const notesEntries = await getCollection('notes', ({ data }) => !data.draft);
const sortedNotes = notesEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Notes"
  description="Thoughts and working notes on MIS, business intelligence, spreadsheet architecture, ERP data integrity, and project operations by Saroj Baral."
>
  <div class="site-container section-padding">
    <div class="max-w-3xl mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] block mb-2">
        Field Notes &amp; Observations
      </span>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-[var(--color-text)] mb-4">
        Notes
      </h1>
      <p class="text-lg md:text-xl text-[var(--color-muted)] leading-relaxed">
        Working reflections on data systems, reporting discipline, and project execution.
      </p>
    </div>

    {sortedNotes.length === 0 ? (
      <div class="card-base p-10 md:p-14 bg-[var(--color-surface)] text-center max-w-2xl mx-auto my-8">
        <div class="w-12 h-12 rounded-full bg-[var(--color-accent-soft)] text-[var(--color-accent)] flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">
          Notes will appear here
        </h2>
        <p class="text-base text-[var(--color-muted)] mb-6">
          Notes will appear here. For now, see the case studies.
        </p>
        <a href={url("/work")} class="btn-base btn-primary text-sm px-5 py-2.5">
          See case studies &rarr;
        </a>
      </div>
    ) : (
      <div class="max-w-3xl space-y-8">
        {sortedNotes.map((note) => (
          <article class="card-base p-6 bg-[var(--color-surface)]">
            <span class="text-xs text-[var(--color-muted)] block mb-1">
              {note.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">
              <a href={url(`/notes/${note.id}`)} class="hover:text-[var(--color-accent)] transition-colors">
                {note.data.title}
              </a>
            </h2>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">
              {note.data.description}
            </p>
            <a href={url(`/notes/${note.id}`)} class="text-sm font-semibold text-[var(--color-accent)] hover:underline">
              Read note &rarr;
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
