---
import { url } from "../utils/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import "@fontsource/noto-serif-devanagari/400.css";
import "@fontsource/noto-serif-devanagari/600.css";

const practice = [
  { sym: "भक्ति", title: "Bhakti", text: "Remembrance, prayer and gratitude. The value lies in the attitude behind the practice, not in display." },
  { sym: "साधना", title: "Sadhana", text: "Returning to a chosen discipline with patience. It matters when it slowly shapes attention and conduct." },
  { sym: "चिन्तन", title: "Contemplation", text: "Making room for silence and honest self-questioning, beyond habit and appearance." },
];

const study = [
  ["Shaiva thought", "शैव दर्शन", "Shiva's nature, symbolism and worship traditions."],
  ["Vedanta and self-inquiry", "वेदान्त र आत्मविचार", "Self, consciousness and liberation through different Vedantic readings."],
  ["Cosmology and the Tattvas", "सृष्टि र तत्त्वचिन्तन", "How Indian philosophies describe creation and existence."],
  ["Scripture, stotra and meaning", "शास्त्र, स्तोत्र र भावार्थ", "Sanskrit verses through language, context and devotional feeling."],
];

const teachers = [
  ["Adi Shankaracharya", "आदि शङ्कराचार्य", "Non-duality, discernment, knowledge and liberation."],
  ["Goswami Tulsidas", "गोस्वामी तुलसीदास", "Devotional poetry that shapes heart and character."],
  ["Sant Tukaram", "सन्त तुकाराम", "Simplicity, humility and direct devotion."],
  ["Gorakhnath", "गोरखनाथ", "Yogic discipline, awareness and inner change."],
  ["Machhindranath", "मच्छिन्द्रनाथ", "The heritage of the Nath tradition."],
  ["Premanand Maharaj", "प्रेमानन्द महाराज", "Contemporary reflections on remembrance and sincerity."],
];
---

<BaseLayout
  title="Beyond Work | Saroj Baral"
  description="A short, personal page on Shiva bhakti, Sanatana Dharma and the learning that sits beside my professional work."
>
  <div class="dev">
    <!-- Hero -->
    <section class="hero">
      <img class="hero-img" src={url("/images/kailash.jpeg")} alt="" width="1376" height="768" fetchpriority="high" />
      <div class="hero-fade" aria-hidden="true"></div>
      <div class="wrap hero-copy">
        <p class="kicker">Beyond work</p>
        <h1>The journey within.</h1>
        <p class="mantra" lang="sa">
          कर्पूरगौरं करुणावतारं संसारसारम् भुजगेन्द्रहारम्।<br />
          सदावसन्तं हृदयारविन्दे भवं भवानीसहितं नमामि॥
        </p>
        <p class="trans">I bow to Shiva, white as camphor, compassion incarnate, the essence of existence, who dwells always in the lotus of the heart.</p>
        <p class="lede">
          A devotee of Lord Shiva and a curious student of Sanatana Dharma. This is a personal journey of learning,
          not a claim of attainment.
        </p>
      </div>
    </section>

    <!-- Foundation -->
    <section class="block">
      <div class="wrap split">
        <div class="head">
          <p class="kicker">Foundation</p>
          <h2>Shiva at the centre.</h2>
          <p class="ne" lang="ne">आराध्य शिव, दृष्टिकोणमा समन्वय।</p>
        </div>
        <div class="body">
          <p>
            Shiva is the centre of my devotional outlook: the ascetic and the householder, the dissolver and
            the source of renewal, the silence beyond words and the presence felt within life.
          </p>
          <p class="ne-body" lang="ne">
            मेरो उपासनाको केन्द्रमा भगवान् शिव हुनुहुन्छ। वैराग्य र गृहस्थ, संहार र पुनःसृजन, मौन र चेतना — शिवतत्त्वका यी आयामले मलाई भक्ति मात्र होइन, चिन्तनतर्फ पनि डोर्‍याउँछन्।
          </p>
          <p>
            My approach is Shiva-centred and respectful of the wider traditions of Sanatana Dharma. I read the
            reverence offered to the Divine in many forms as an invitation to understand unity.
          </p>
          <p class="pull"><span lang="sa">शिवोऽहम्</span> is a line I contemplate, not something I claim.</p>
        </div>
      </div>
    </section>

    <!-- Practice -->
    <section class="block tint">
      <div class="wrap">
        <div class="head wide">
          <p class="kicker">Practice</p>
          <h2>Devotion as a daily orientation.</h2>
          <p class="ne" lang="ne">भक्ति केवल कर्मकाण्ड होइन, जीवनलाई हेर्ने भाव पनि हो।</p>
        </div>
        <div class="three">
          {practice.map((p) => (
            <div class="pcol">
              <span class="sym" lang="ne" aria-hidden="true">{p.sym}</span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          ))}
        </div>
        <p class="private">The details of personal worship stay private. What I share here is the direction, not the routine.</p>
      </div>
    </section>

    <!-- Learning + teachers -->
    <section class="block">
      <div class="wrap duo">
        <div>
          <p class="kicker">Inquiry</p>
          <h2>Learning is part of the path.</h2>
          <p class="ne" lang="ne">श्रद्धासँगै प्रश्न, अध्ययन र विवेक पनि आवश्यक छन्।</p>
          <ul class="list">
            {study.map(([en, ne, d]) => (
              <li>
                <h3>{en} <span lang="ne">{ne}</span></h3>
                <p>{d}</p>
              </li>
            ))}
          </ul>
          <p class="private">I study as a learner. Each school has its own foundations; understanding takes patience, not a single conclusion.</p>
        </div>
        <div>
          <p class="kicker">Inspiration</p>
          <h2>Learning from those who walked before.</h2>
          <p class="ne" lang="ne">सन्त, आचार्य र साधकका जीवनबाट प्रेरणा।</p>
          <ul class="list">
            {teachers.map(([en, ne, d]) => (
              <li>
                <h3>{en} <span lang="ne">{ne}</span></h3>
                <p>{d}</p>
              </li>
            ))}
          </ul>
          <p class="private">Sources of reflection, not a claim of belonging to any lineage.</p>
        </div>
      </div>
    </section>

    <!-- Where worlds meet -->
    <section class="block tint">
      <div class="wrap split">
        <div class="head">
          <p class="kicker">Where worlds meet</p>
          <h2>When learning becomes making.</h2>
          <p class="ne" lang="ne">अध्ययन, प्रविधि र भक्तिको सानो संगम।</p>
        </div>
        <div class="body">
          <p>
            My engineering background gives me a habit of bringing structure to ideas. In my spiritual studies
            that became a small personal project: organising prayers and stotras, studying their meanings, and
            building a digital space where devotional material can be approached with clarity and care.
          </p>
          <p>
            It is a personal undertaking, not an institution or a source of spiritual authority. Its purpose is
            to support learning and remembrance.
          </p>
        </div>
      </div>
    </section>

    <!-- Closing -->
    <section class="closing">
      <div class="wrap closing-in">
        <p class="om" aria-hidden="true">ॐ</p>
        <h2>Not a destination.<br />A lifelong unfolding.</h2>
        <p class="ne" lang="ne">सिकाइ जारी छ। खोज जारी छ। यात्रा जारी छ।</p>
        <p class="verse" lang="sa">असतो मा सद्गमय । तमसो मा ज्योतिर्गमय । मृत्योर्माऽमृतं गमय ॥</p>
        <p class="trans">Lead me from the unreal to the real, from darkness to light, from mortality to immortality.</p>
        <p class="sign" lang="sa">साम्ब सदाशिव · ॐ शान्तिः शान्तिः शान्तिः</p>
        <nav class="links" aria-label="Continue">
          <a href={url("/about")}>About me</a>
          <a href={url("/experience")}>Experience</a>
          <a href={url("/contact")}>Get in touch</a>
        </nav>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .dev {
    --bg: #07112A; --bg2: #0A1736; --text: #DCE4F2; --muted: #AAB7CE; --gold: #D9B978;
    --line: rgba(217, 185, 120, 0.22); --hair: rgba(255, 255, 255, 0.10);
    background: var(--bg); color: var(--text); overflow: hidden;
  }
  .wrap { width: min(1160px, calc(100% - 48px)); margin-inline: auto; }
  .kicker { color: var(--gold); font-size: 12.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; margin: 0 0 16px; }
  h1, h2, h3 { font-family: inherit; color: #fff; }
  h2 { font-size: clamp(1.7rem, 3vw, 2.35rem); line-height: 1.15; letter-spacing: -0.025em; font-weight: 650; margin: 0 0 14px; max-width: 18ch; }
  h3 { font-size: 1rem; font-weight: 600; margin: 0 0 4px; letter-spacing: 0; }
  h3 span, .sym, .ne, .ne-body, .mantra, .verse, .sign { font-family: "Noto Serif Devanagari", Georgia, serif; }
  h3 span { color: var(--gold); font-size: 0.86em; font-weight: 400; margin-left: 4px; }
  .ne { color: var(--gold); font-size: 1rem; line-height: 1.8; margin: 0; }
  p { line-height: 1.75; }

  /* Hero */
  .hero { position: relative; min-height: min(86vh, 780px); display: flex; align-items: flex-end; isolation: isolate; }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 22%; z-index: -2; }
  .hero-fade { position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(7, 17, 42, 0.35) 0%, rgba(7, 17, 42, 0) 28%, rgba(7, 17, 42, 0.78) 72%, var(--bg) 100%),
      linear-gradient(90deg, rgba(7, 17, 42, 0.72) 0%, rgba(7, 17, 42, 0) 62%); }
  .hero-copy { padding-block: 120px 72px; }
  .hero h1 { font-size: clamp(2.8rem, 6.5vw, 5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 24px; }
  .mantra { color: var(--gold); font-size: clamp(1.15rem, 2.2vw, 1.55rem); line-height: 1.7; margin: 0 0 10px; }
  .trans { color: var(--muted); font-size: 14.5px; line-height: 1.65; max-width: 54ch; margin: 0 0 22px; }
  .lede { font-size: 1.08rem; max-width: 52ch; margin: 0; color: #E6ECF7; }

  /* Sections */
  .block { padding: 96px 0; }
  .tint { background: var(--bg2); border-block: 1px solid var(--hair); }
  .split { display: grid; gap: 28px; }
  .head.wide { margin-bottom: 40px; }
  .body p { font-size: 1.04rem; max-width: 62ch; margin: 0 0 18px; }
  .ne-body { color: #B9C4D8; font-size: 0.98rem !important; line-height: 1.9 !important; }
  .pull { border-left: 2px solid var(--gold); padding-left: 18px; color: #E6ECF7; font-size: 1rem !important; margin-top: 28px !important; }
  .pull span { font-family: "Noto Serif Devanagari", Georgia, serif; color: var(--gold); font-size: 1.2em; }

  .three { display: grid; gap: 0; }
  .pcol { padding: 26px 0; border-top: 1px solid var(--hair); }
  .sym { display: block; color: var(--gold); font-size: 1.7rem; line-height: 1.3; margin-bottom: 10px; }
  .pcol p { color: var(--muted); font-size: 0.98rem; max-width: 36ch; margin: 0; }
  .private { color: #8E9DB8; font-size: 13.5px; margin: 28px 0 0; max-width: 60ch; }

  .duo { display: grid; gap: 64px; }
  .list { list-style: none; margin: 28px 0 0; padding: 0; }
  .list li { padding: 16px 0; border-top: 1px solid var(--hair); }
  .list li:last-child { border-bottom: 1px solid var(--hair); }
  .list p { color: var(--muted); font-size: 0.95rem; line-height: 1.6; margin: 0; max-width: 52ch; }

  /* Closing */
  .closing { padding: 110px 0 96px; text-align: center; background: radial-gradient(60% 70% at 50% 0%, rgba(47, 111, 237, 0.14), transparent 70%), var(--bg); }
  .closing-in { max-width: 760px; }
  .om { font-family: "Noto Serif Devanagari", Georgia, serif; color: var(--gold); font-size: 3.4rem; line-height: 1; margin: 0 0 16px; opacity: 0.9; }
  .closing h2 { max-width: none; margin-inline: auto; }
  .verse { color: #fff; font-size: clamp(1.15rem, 2.4vw, 1.5rem); line-height: 1.8; margin: 34px 0 6px; }
  .closing .trans { margin-inline: auto; }
  .sign { color: var(--gold); margin: 24px 0 0; }
  .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 40px; }
  .links a { color: #fff; font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; padding-bottom: 4px; border-bottom: 1px solid rgba(255, 255, 255, 0.35); }
  .links a:hover { border-color: var(--gold); color: var(--gold); }

  @media (min-width: 900px) {
    .split { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 72px; }
    .three { grid-template-columns: repeat(3, 1fr); gap: 40px; }
    .pcol { border-top: 1px solid var(--line); }
    .duo { grid-template-columns: 1fr 1fr; gap: 80px; }
    .block { padding: 120px 0; }
  }
  @media (max-width: 640px) {
    .hero { min-height: 640px; }
    .hero-img { object-position: 52% 10%; }
    .hero-fade { background: linear-gradient(180deg, rgba(7, 17, 42, 0.35) 0%, rgba(7, 17, 42, 0.45) 30%, rgba(7, 17, 42, 0.9) 58%, var(--bg) 100%); }
  }
</style>
