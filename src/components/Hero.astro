---
import { url } from "../utils/url";
import Icon from "./Icon.astro";
import cv from "../data/cv.json";

const stat = cv.highlight;
const slides = [
  { kind: 'Career highlight', icon: 'chart', title: stat.label, big: stat.value, text: stat.text },
  ...cv.recognition.map((r) => ({ kind: 'Recognition', icon: r.icon, title: r.title, big: '', text: r.text })),
];
---

<section class="hero">
  <svg class="rings" viewBox="0 0 800 600" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <g fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="1">
      <circle cx="640" cy="300" r="180" /><circle cx="640" cy="300" r="260" /><circle cx="640" cy="300" r="340" /><circle cx="640" cy="300" r="420" />
    </g>
  </svg>

  <div class="site-container hero-grid">
    <div class="copy">
      <p class="eyebrow">MIS <i>•</i> Project Control <i>•</i> Business Operations</p>
      <h1>Turning information<br />into <span>clarity.</span></h1>
      <p class="lede">
        Engineer by background. Business professional by experience. <br class="lg" />
        I help teams and businesses make sense of data, streamline processes and deliver results.
      </p>

      <ul class="meta">
        <li><Icon name="pin" size={18} /> Kathmandu, Nepal</li>
        <li><Icon name="briefcase" size={18} /> 6+ Years Experience</li>
        <li><Icon name="cap" size={18} /> EMBA</li>
      </ul>

      <div class="actions">
        <a href={url("/cv")} class="btn-hero primary">View my CV <Icon name="download" size={16} /></a>
        <a href={url("/contact")} class="btn-hero ghost">Contact me <Icon name="arrow" size={16} /></a>
      </div>
    </div>

    <div class="photo">
      <img
        src={url("/images/saroj-cutout.webp")}
        alt="Portrait of Saroj Baral in a navy blazer and white shirt"
        width="900"
        height="1117"
        fetchpriority="high"
      />
      <aside class="glass" role="group" aria-roledescription="carousel" aria-label="Career highlights and recognition">
        <div class="slides">
          {slides.map((s, i) => (
            <div class={`slide${i === 0 ? ' on' : ''}`} role="group" aria-roledescription="slide" aria-label={`${i + 1} of ${slides.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
              <span class="mark" aria-hidden="true"><Icon name={s.icon} size={120} stroke={0.8} /></span>
              <p class="kind"><i></i>{s.kind}</p>
              <span class="medal" aria-hidden="true"><Icon name={s.icon} size={22} stroke={1.6} /></span>
              <p class="label">{s.title}</p>
              {s.big && <p class="big">{s.big}</p>}
              <p class="small">{s.text}</p>
            </div>
          ))}
        </div>
        <div class="ctrl">
          <div class="dots">
            {slides.map((s, i) => (
              <button type="button" class={i === 0 ? 'on' : ''} aria-label={`Show ${s.title}`} data-i={i}></button>
            ))}
          </div>
          <button type="button" class="pause" aria-label="Pause slideshow" data-state="playing"><span class="bars"></span></button>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; overflow: hidden; color: #fff;
    background:
      radial-gradient(55% 85% at 78% 38%, #55585F 0%, #2B2E36 40%, rgba(20, 22, 29, 0) 75%),
      linear-gradient(100deg, #050B18 0%, #07112A 52%, #15171E 100%);
  }
  .rings { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .hero-grid { display: grid; grid-template-columns: 1fr; gap: 0; }
  .copy { padding: 56px 0 24px; z-index: 2; }
  .hero { padding-bottom: 28px; }

  .eyebrow { color: var(--blue-bright); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; margin: 0 0 22px; }
  .eyebrow i { font-style: normal; margin: 0 6px; opacity: 0.9; }
  h1 { color: #fff; font-size: clamp(2.4rem, 3.7vw, 3.55rem); line-height: 1.1; letter-spacing: -0.035em; font-weight: 700; margin: 0 0 24px; }
  h1 span { color: var(--blue-bright); }
  .lede { font-size: 1.08rem; line-height: 1.7; color: #D8DFEC; max-width: 34rem; margin: 0 0 26px; }
  .lg { display: none; }

  .meta { list-style: none; display: flex; flex-wrap: wrap; gap: 14px 30px; padding: 0; margin: 0 0 30px; font-size: 14.5px; color: #E3E8F3; }
  .meta li { display: inline-flex; align-items: center; gap: 9px; }
  .meta :global(svg) { color: var(--blue-bright); }

  .actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .btn-hero {
    display: inline-flex; align-items: center; gap: 12px; text-decoration: none;
    font-size: 13px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 14px 22px; border-radius: 3px; transition: background-color 0.15s ease, border-color 0.15s ease;
  }
  .btn-hero.primary { background: var(--btn-bg); color: #fff; border: 1px solid var(--btn-bg); }
  .btn-hero.primary:hover { background: var(--btn-bg-hover); border-color: var(--btn-bg-hover); }
  .btn-hero.ghost { color: #fff; border: 1px solid rgba(255, 255, 255, 0.45); }
  .btn-hero.ghost:hover { border-color: #fff; background: rgba(255, 255, 255, 0.08); }

  .photo { position: relative; display: flex; flex-direction: column; align-items: center; margin-top: 8px; }
  .photo img { display: block; width: min(86%, 380px); height: auto; filter: saturate(0.92) contrast(1.03);
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 12%, #000 88%, transparent 100%); }
  .glass {
    margin: -64px 0 28px; width: min(100%, 280px); padding: 20px 22px 14px;
    background: linear-gradient(160deg, rgba(34, 52, 92, 0.72), rgba(14, 22, 44, 0.72));
    border: 1px solid rgba(143, 184, 255, 0.28); border-radius: 8px;
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 14px 34px rgba(2, 8, 24, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    position: relative; overflow: hidden;
  }
  .glass::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, transparent, #6EA2FF, transparent); }
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; position: relative; min-height: 224px; opacity: 0; visibility: hidden; transition: opacity 0.8s ease, visibility 0s linear 0.8s; }
  .slide.on { opacity: 1; visibility: visible; transition: opacity 0.8s ease; }
  .mark { position: absolute; right: -26px; bottom: -22px; color: rgba(143, 184, 255, 0.11); pointer-events: none; }
  .kind { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 11.5px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #8DBBFF; }
  .kind i { width: 18px; height: 1px; background: #8DBBFF; display: inline-block; }
  .medal { display: inline-flex; width: 46px; height: 46px; align-items: center; justify-content: center; border-radius: 50%; color: #BCD6FF; margin-bottom: 12px;
    background: radial-gradient(circle at 35% 30%, #2C54A8, #16306B); box-shadow: 0 0 0 4px rgba(110, 162, 255, 0.14), 0 0 0 9px rgba(110, 162, 255, 0.06); }
  .label { font-size: 15.5px; font-weight: 600; line-height: 1.3; margin: 0 0 6px; color: #fff; position: relative; }
  .big { font-size: 2.6rem; font-weight: 700; line-height: 1.05; letter-spacing: -0.02em; margin: 0 0 6px; color: #fff; position: relative; }
  .small { font-size: 13.5px; line-height: 1.5; margin: 0; color: #C9D3E8; position: relative; max-width: 24ch; }
  .ctrl { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; position: relative; }
  .dots { display: flex; gap: 2px; }
  .dots button { width: 22px; height: 22px; padding: 0; border: 0; background: transparent; cursor: pointer; position: relative; }
  .dots button::after { content: ""; position: absolute; left: 50%; top: 50%; width: 6px; height: 6px; margin: -3px 0 0 -3px; border-radius: 50%; background: rgba(255, 255, 255, 0.3); transition: background 0.3s, width 0.3s, margin 0.3s; }
  .dots button.on::after { background: #6EA2FF; width: 16px; margin-left: -8px; border-radius: 4px; }
  .pause { width: 26px; height: 26px; border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 50%; background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .pause:hover { border-color: #fff; }
  .bars { width: 8px; height: 9px; border-left: 2.5px solid #D8E4FA; border-right: 2.5px solid #D8E4FA; box-sizing: border-box; }
  .pause[data-state="paused"] .bars { border: 0; border-left: 8px solid #D8E4FA; border-top: 5px solid transparent; border-bottom: 5px solid transparent; width: 0; height: 0; margin-left: 2px; }
  .dots button:focus-visible, .pause:focus-visible { outline: 2px solid #9FC2FF; outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .slide, .slide.on { transition: none; } .pause { display: none; } }

  @media (min-width: 960px) {
    .lg { display: inline; }
    .hero { min-height: 570px; }
    .hero-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); min-height: 570px; }
    .copy { padding: 72px 0 92px; }
    .photo { position: static; display: block; margin: 0; }
    .photo img {
      position: absolute; right: max(0px, calc((100vw - 1320px) / 2 + 60px)); bottom: 0;
      height: 104%; width: auto; max-width: none;
      -webkit-mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 88%, transparent 100%);
      mask-image: linear-gradient(to right, transparent 0, #000 16%, #000 88%, transparent 100%);
    }
    .glass { position: absolute; margin: 0; width: 270px; left: calc(50% - 52px); bottom: 118px; z-index: 3; }
  }
  @media (min-width: 1280px) { .glass { left: calc(50% - 24px); } }
</style>

<script>
  const root = document.querySelector('.hero .glass');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dots button'));
    const pauseBtn = root.querySelector<HTMLButtonElement>('.pause')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DWELL = 6000;
    let i = 0, timer: number | undefined, userPaused = false, hovering = false;

    const show = (n: number) => {
      i = (n + slides.length) % slides.length;
      slides.forEach((s, k) => { s.classList.toggle('on', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
    };
    const stop = () => { if (timer) { clearInterval(timer); timer = undefined; } };
    const play = () => { stop(); if (!reduce && !userPaused && !hovering) timer = window.setInterval(() => show(i + 1), DWELL); };

    dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.dataset.i)); play(); }));
    pauseBtn.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.dataset.state = userPaused ? 'paused' : 'playing';
      pauseBtn.setAttribute('aria-label', userPaused ? 'Play slideshow' : 'Pause slideshow');
      play();
    });
    root.addEventListener('mouseenter', () => { hovering = true; stop(); });
    root.addEventListener('mouseleave', () => { hovering = false; play(); });
    root.addEventListener('focusin', () => { hovering = true; stop(); });
    root.addEventListener('focusout', () => { hovering = false; play(); });
    play();
  }
</script>
