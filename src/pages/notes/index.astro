---
import { url } from "../../utils/url";
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getCollection } from 'astro:content';

const notesEntries = await getCollection('notes', ({ data }) => !data.draft);
const sortedNotes = notesEntries.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Notes"
  description="Thoughts and working notes on MIS, project control, spreadsheet architecture, ERP data integrity, and project operations by Saroj Baral."
>
  <div class="site-container section-padding">
    <header class="page-head">
      <span class="eyebrow">Field Notes &amp; Observations</span>
      <h1>Notes</h1>
      <p>Working reflections on data systems, reporting discipline, and project execution.</p>
    </header>

    {sortedNotes.length === 0 ? (
      <div class="card-base p-10 md:p-14 bg-[var(--color-surface)] text-center max-w-2xl mx-auto my-8">
        <span class="icon-tile mx-auto mb-4" style="width:48px;height:48px;border-radius:999px"><Icon name="file-text" size={22} /></span>
        <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">
          Notes will appear here
        </h2>
        <p class="text-base text-[var(--color-muted)] mb-6">
          Notes will appear here. For now, see the case studies.
        </p>
        <a href={url("/work")} class="btn-base btn-primary text-sm px-5 py-2.5">
          See case studies &rarr;
        </a>
      </div>
    ) : (
      <div class="max-w-3xl space-y-8">
        {sortedNotes.map((note) => (
          <article class="card-base p-6 bg-[var(--color-surface)]">
            <span class="text-xs text-[var(--color-muted)] block mb-1">
              {note.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <h2 class="text-xl font-bold text-[var(--color-text)] mb-2">
              <a href={url(`/notes/${note.id}`)} class="hover:text-[var(--color-accent)] transition-colors">
                {note.data.title}
              </a>
            </h2>
            <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">
              {note.data.description}
            </p>
            <a href={url(`/notes/${note.id}`)} class="text-sm font-semibold text-[var(--color-accent)] hover:underline">
              Read note &rarr;
            </a>
          </article>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
