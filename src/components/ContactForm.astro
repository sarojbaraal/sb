---
import { url } from "../utils/url";
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  class="card-base p-6 md:p-8 space-y-5"
>
  <!-- Web3Forms Access Key -->
  <input type="hidden" name="access_key" value="fbe622e7-0d4d-479d-9201-4b1ed9223f6a" />

  <!-- Redirect after a successful submit -->
  <input
    type="hidden"
    name="redirect"
    value={new URL(url("/thank-you"), Astro.site ?? "https://sarojbaral.com.np").href}
  />

  <!-- Honeypot spam protection -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none;"
    tabindex="-1"
    autocomplete="off"
  />

  <!-- Subject line for the email notification -->
  <input type="hidden" name="subject" value="New Inquiry from sarojbaral.com.np" />

  <div>
    <label for="name" class="form-label">
      Your name <span class="text-[var(--color-accent)]" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      placeholder="e.g. Ramesh Shrestha"
      class="form-input"
    />
  </div>

  <div>
    <label for="email" class="form-label">
      Email address <span class="text-[var(--color-accent)]" aria-hidden="true">*</span>
    </label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      placeholder="name@company.com"
      class="form-input"
    />
  </div>

  <div>
    <label for="need" class="form-label">
      What can I help you with? <span class="text-[var(--color-accent)]" aria-hidden="true">*</span>
    </label>
    <select id="need" name="need" required class="form-input">
      <option value="" disabled selected>Select an option...</option>
      <option value="mis-reporting">MIS &amp; reporting</option>
      <option value="doc-control">Data &amp; document control</option>
      <option value="project-coordination">Project coordination</option>
      <option value="website">Website for my business</option>
      <option value="teaching">Teaching</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div>
    <label for="message" class="form-label">
      Project details or message <span class="text-[var(--color-accent)]" aria-hidden="true">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      placeholder="Briefly describe what you are looking to solve, your timeline, or any specific questions..."
      class="form-input resize-y"
    ></textarea>
  </div>

  <button type="submit" class="btn-base btn-primary w-full text-base py-3">
    Send message &rarr;
  </button>

  <p class="text-xs text-[var(--color-muted)] text-center m-0">
    Direct response guaranteed within 1–2 business days. No spam, ever.
  </p>
</form>
