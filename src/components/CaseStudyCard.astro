---
import { url } from "../utils/url";
interface Props {
  slug: string;
  title: string;
  summary: string;
  client_type: string;
  year: number;
  services: string[];
  tools: string[];
  result_metrics: string[];
  cover?: string;
}

const {
  slug,
  title,
  summary,
  client_type,
  year,
  services,
  tools,
  result_metrics,
} = Astro.props;
---

<article class="card-base p-6 md:p-7 flex flex-col justify-between hover:border-[var(--color-accent)]/50 transition-all group">
  <div>
    <!-- Header Meta: Client Type & Year -->
    <div class="flex items-center justify-between text-xs text-[var(--color-muted)] mb-3 pb-2 border-b border-[var(--color-border)]">
      <span class="font-medium text-[var(--color-accent)]">{client_type}</span>
      <span>{year}</span>
    </div>

    <!-- Title -->
    <h3 class="text-xl font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors mb-2.5">
      <a href={url(`/work/${slug}`)} class="focus-visible:outline-none focus-visible:underline">
        {title}
      </a>
    </h3>

    <!-- Summary -->
    <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">
      {summary}
    </p>

    <!-- Highlight Metric Line -->
    {result_metrics.length > 0 && (
      <div class="p-3 bg-[var(--color-bg)] rounded-lg border border-[var(--color-border)] mb-4">
        <span class="text-xs font-semibold text-[var(--color-accent)] block mb-0.5">Key Result:</span>
        <span class="text-xs text-[var(--color-text)] font-medium leading-snug block">
          {result_metrics[0]}
        </span>
      </div>
    )}

    <!-- Tags: Services & Tools -->
    <div class="flex flex-wrap gap-1.5 mb-6">
      {services.map((service) => (
        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-[var(--color-bg)] text-[var(--color-text)] border border-[var(--color-border)]">
          {service}
        </span>
      ))}
      {tools.slice(0, 2).map((tool) => (
        <span class="inline-block px-2 py-0.5 rounded text-[11px] font-medium bg-[var(--color-surface)] text-[var(--color-muted)] border border-[var(--color-border)]">
          {tool}
        </span>
      ))}
    </div>
  </div>

  <!-- Footer Link -->
  <div class="pt-2">
    <a
      href={url(`/work/${slug}`)}
      class="inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-accent)] group-hover:text-[var(--color-accent-hover)] transition-colors"
    >
      <span>Read case study</span>
      <span aria-hidden="true">&rarr;</span>
    </a>
  </div>
</article>

