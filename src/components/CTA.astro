---
import { url } from "../utils/url";
import Icon from "./Icon.astro";

interface Props {
  title: string;
  description: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  title,
  description,
  primaryText = 'Contact me',
  primaryHref = '/contact',
  secondaryText,
  secondaryHref,
} = Astro.props;
---

<div class="card-base cta-card">
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <div class="cta-card__actions">
    <a href={url(primaryHref)} class="btn-base btn-primary">
      {primaryText}
      <Icon name="arrow-right" size={16} />
    </a>
    {secondaryText && secondaryHref && (
      <a href={url(secondaryHref)} class="btn-base btn-secondary">{secondaryText}</a>
    )}
  </div>
</div>
