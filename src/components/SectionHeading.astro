---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class={`mb-8 md:mb-10 ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-3xl'}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2 class="mb-3" set:html={title} />
  {intro && (
    <p class="text-base md:text-lg text-[var(--color-muted)] leading-relaxed prose-measure m-0">
      {intro}
    </p>
  )}
</div>
