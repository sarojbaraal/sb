---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import CvDocument from '../components/CvDocument.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae of Saroj Baral: project control, MIS and business operations. Six years at Huawei Technologies Nepal, Executive MBA, independent consultant."
>
  <section class="page-head no-print">
    <div class="site-container cv-bar">
      <div>
        <p class="kicker">Curriculum vitae</p>
        <h1>My CV</h1>
        <p>Read it here, print it from this page, or download the two-page PDF.</p>
      </div>
      <div class="cv-actions">
        <a href={url("/cv/Saroj-Baral-CV.pdf")} download="Saroj-Baral-CV.pdf" class="btn-base btn-primary"><Icon name="download" size={16} />&nbsp; Download PDF</a>
        <button type="button" class="btn-base cv-print-btn" onclick="window.print()"><Icon name="print" size={16} />&nbsp; Print</button>
      </div>
    </div>
  </section>

  <div class="cv-stage">
    <div class="cv-paper">
      <CvDocument />
    </div>
  </div>
</BaseLayout>

<style is:global>
  .cv-bar { display: grid; gap: 20px; align-items: end; }
  .cv-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cv-print-btn { background: transparent; color: #fff; border: 1px solid rgba(255, 255, 255, 0.4); }
  .cv-print-btn:hover { background: rgba(255, 255, 255, 0.08); border-color: #fff; }
  @media (min-width: 760px) { .cv-bar { grid-template-columns: 1fr auto; } }

  .cv-stage { padding: 32px 16px 56px; background: var(--color-bg); }
  .cv-paper {
    width: 100%; max-width: 210mm; margin: 0 auto; padding: 14mm 16mm;
    background: #fff; border: 1px solid var(--color-border); border-radius: 4px;
    box-shadow: 0 6px 24px rgba(8, 19, 42, 0.08);
  }
  @media (max-width: 640px) { .cv-paper { padding: 22px 18px; } }

  @page { size: A4; margin: 13mm 15mm; }
  @media print {
    html, body { background: #fff !important; }
    .cv-stage { padding: 0 !important; background: #fff !important; }
    .cv-paper { max-width: none !important; padding: 0 !important; border: 0 !important; box-shadow: none !important; border-radius: 0 !important; }
    .cv-doc { color: #0F1B33; }
  }
</style>
