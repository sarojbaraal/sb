---
// Print layout used only to render public/cv/Saroj-Baral-CV.pdf (see scripts/build-cv.sh).
import "../styles/global.css";
import CvDocument from '../components/CvDocument.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <title>Saroj Baral, CV</title>
  </head>
  <body class="cv-pdf">
    <CvDocument />
  </body>
</html>

<style is:global>
  @page { size: A4; margin: 13mm 15mm; }
  html { background: #fff !important; }
  body.cv-pdf { display: block; min-height: 0; background: #fff; }
</style>
