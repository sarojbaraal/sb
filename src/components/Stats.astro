---
import profile from '../data/profile.json';

const items = profile.proofStrip;
const tools = profile.tools;
---

<section class="stats" aria-label="At a glance">
  <div class="site-container">
    <ul class="stats__list card-base">
      {items.map((item) => (
        <li class="stat">
          <span class="stat__value">
            {/^\d+$/.test(item.value) ? (
              <><span data-count={item.value}>{item.value}</span>{'suffix' in item && item.suffix}</>
            ) : (
              item.value
            )}
          </span>
          <span class="stat__label">{item.label}</span>
        </li>
      ))}
    </ul>

    <p class="tools-row">
      <span class="tools-row__label">Tools and systems</span>
      {tools.map((tool) => <span class="tag">{tool}</span>)}
    </p>
  </div>
</section>
