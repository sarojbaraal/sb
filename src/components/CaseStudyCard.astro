---
import { url } from "../utils/url";
import { splitKpi } from "../utils/kpi";
import Icon from "./Icon.astro";

interface Props {
  slug: string;
  title: string;
  summary: string;
  client_type: string;
  year: number;
  services?: string[];
  tools: string[];
  result_metrics: string[];
  kpi?: { from?: string; to: string; label: string };
  cover?: string;
}

const { slug, title, summary, client_type, year, tools, result_metrics, kpi } = Astro.props;

const from = kpi?.from ? splitKpi(kpi.from) : null;
const to = kpi ? splitKpi(kpi.to) : null;
---

<article class="card-base card-hover work-card">
  <!-- The key result is the visual hero of the card -->
  <div class="work-card__kpi">
    <p class="kpi-eyebrow">
      <span>Key result</span>
      <span>Illustrative sample</span>
    </p>

    {kpi && to ? (
      <>
        <p class="kpi-value">
          {from && (
            <>
              <span class="from">
                {from.prefix}{from.num !== null && <span data-count={from.num}>{from.num}</span>}{from.suffix}
              </span>
              <Icon name="arrow-right" size={22} class="arrow" />
            </>
          )}
          <span class="to">
            {to.prefix}{to.num !== null && <span data-count={to.num}>{to.num}</span>}{to.suffix}
          </span>
        </p>
        <p class="kpi-label">{kpi.label}</p>
      </>
    ) : (
      <p class="kpi-value" style="font-size:1.25rem;letter-spacing:-0.01em">{result_metrics[0]}</p>
    )}
  </div>

  <div class="work-card__body">
    <p class="work-card__meta">{client_type} &middot; {year}</p>
    <h3>
      <a href={url(`/work/${slug}`)} class="stretched-link" style="text-decoration:none;color:inherit">{title}</a>
    </h3>
    <p class="work-card__summary">{summary}</p>
    <div class="tag-row">
      {tools.slice(0, 3).map((tool) => <span class="tag">{tool}</span>)}
    </div>
  </div>
</article>
