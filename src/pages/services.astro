---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTA from '../components/CTA.astro';
import services from '../data/services.json';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: services.map((s, index) => ({
    '@type': 'Service',
    position: index + 1,
    name: s.title,
    description: s.bullets.join(' '),
    provider: {
      '@type': 'Person',
      name: 'Saroj Baral',
    },
    offers: {
      '@type': 'Offer',
      description: `${s.priceFrom}. ${s.engagement}`,
      priceCurrency: 'NPR',
    },
  })),
};
---

<BaseLayout
  title="Services"
  description="Explore professional MIS, project control, document control, and project coordination services offered by Saroj Baral."
  jsonLd={jsonLd}
>
  <div class="site-container section-padding">
    <!-- Header -->
    <header class="page-head">
      <span class="eyebrow">Core Offerings</span>
      <h1>Services</h1>
      <p>Three ways I usually help — pick the one that matches your problem.</p>
    </header>

    <!-- Service Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {services.map((service) => (
        <ServiceCard
          id={service.id}
          label={service.label}
          title={service.title}
          priceFrom={service.priceFrom}
          engagement={service.engagement}
          bullets={service.bullets}
          ctaText="Request this"
          ctaHref={`/contact?service=${service.id}`}
        />
      ))}
    </div>

    <!-- Bottom Advisory CTA -->
    <CTA
      title="Not sure which one?"
      description="Send a short description of the mess — I'll tell you honestly if I can help and what it would take."
      primaryText="Contact me"
      primaryHref="/contact"
      secondaryText="See website packages"
      secondaryHref="/websites"
    />
  </div>
</BaseLayout>

