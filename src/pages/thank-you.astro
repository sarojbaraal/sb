---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Thank You"
  description="Your message has been received. Saroj Baral will reply within 1–2 business days."
>
  <div class="site-container section-padding flex items-center justify-center min-h-[50vh]">
    <div class="card-base p-8 md:p-12 bg-[var(--color-surface)] text-center max-w-lg mx-auto shadow-sm">
      <span class="icon-tile mx-auto mb-6" style="width:56px;height:56px;border-radius:999px"><Icon name="check" size={26} strokeWidth={2.5} /></span>

      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-3">
        Thanks &mdash; your message is on its way.
      </h1>

      <p class="text-base text-[var(--color-muted)] leading-relaxed mb-8">
        I'll reply within 1–2 business days.
      </p>

      <a href={url("/")} class="btn-base btn-primary text-sm px-6 py-2.5">
        Back to home &rarr;
      </a>
    </div>
  </div>
</BaseLayout>

