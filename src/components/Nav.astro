---
import { url, stripBase } from "../utils/url";
import Icon from "./Icon.astro";

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/notes', label: 'Notes' },
  { href: '/cv', label: 'CV' },
];

const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-header" data-site-header>
  <div class="site-container site-header__bar">
    <!-- Brand -->
    <a href={url("/")} class="brand" aria-label="Saroj Baral, home">
      <span class="brand__mark" aria-hidden="true">SB</span>
      <span>Saroj Baral</span>
    </a>

    <!-- Desktop navigation -->
    <nav class="nav-desktop" aria-label="Main">
      {navLinks.map((link) => (
        <a href={url(link.href)} class="nav-link" aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a href={url("/contact")} class="btn-base btn-primary btn-sm nav-cta">Contact me</a>

      <!-- Mobile menu toggle -->
      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="icon-open"><Icon name="menu" size={22} /></span>
        <span class="icon-close"><Icon name="x" size={22} /></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel (toggled by src/scripts/site.ts) -->
  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav class="site-container mobile-menu__inner" aria-label="Mobile">
      {navLinks.map((link) => (
        <a href={url(link.href)} class="mobile-link" aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href={url("/contact")} class="btn-base btn-primary" style="margin-top:16px">Contact me</a>
    </nav>
  </div>
</header>
