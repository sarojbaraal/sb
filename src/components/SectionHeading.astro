---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class={`mb-8 md:mb-12 ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-3xl'}`}>
  <h2 class="text-[var(--color-text)] mb-3">
    {title}
  </h2>
  {intro && (
    <p class="text-base md:text-lg text-[var(--color-muted)] leading-relaxed prose-measure">
      {intro}
    </p>
  )}
</div>

