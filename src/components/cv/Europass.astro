---
// Europass-style layout (labels left, content right). Not an official Europass file; no date of birth by choice.
import { person, jobs, edu, stack, strengths } from '../../lib/cv';
---

<article class="eu cvx" aria-label="Europass-style CV">
  <header class="eu-top">
    <p class="eu-mark">Curriculum Vitae</p>
    <h1>{person.name}</h1>
  </header>

  <section class="eu-sec">
    <h2>Personal information</h2>
    <dl class="eu-dl">
      <dt>Address</dt><dd>{person.city}, {person.country}</dd>
      <dt>Email</dt><dd>{person.email}</dd>
      <dt>Phone</dt><dd>{person.phone}</dd>
      <dt>LinkedIn</dt><dd>{person.linkedin}</dd>
    </dl>
  </section>

  <section class="eu-sec">
    <h2>Desired field</h2>
    <p class="eu-body"><strong>{person.headline}</strong></p>
    <p class="eu-body">{person.summary}</p>
  </section>

  <section class="eu-sec">
    <h2>Work experience</h2>
    {jobs.map((j) => (
      <div class="eu-item">
        <p class="eu-when">{j.period}</p>
        <div class="eu-body">
          <h3>{j.titleLine}</h3>
          <p class="eu-org">{j.org}, {j.location}</p>
          <ul>
            {'groups' in j && j.groups
              ? j.groups.map((g) => <li><b>{g.title}.</b> {g.bullets.map((b) => b.replace(/\.$/, '')).slice(0, 2).join('. ')}.</li>)
              : j.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </div>
    ))}
  </section>

  <section class="eu-sec">
    <h2>Education and training</h2>
    {edu.map((e) => (
      <div class="eu-item">
        <p class="eu-when">{e.period}</p>
        <div class="eu-body"><h3>{e.degree}</h3><p class="eu-org">{e.institution}, {e.location}</p><p>{e.summary}</p></div>
      </div>
    ))}
  </section>

  <section class="eu-sec">
    <h2>Personal skills</h2>
    <dl class="eu-dl">
      <dt>Mother tongue</dt><dd>{person.languages[0].name}</dd>
      <dt>Other languages</dt>
      <dd>{person.languages.slice(1).map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ')}</dd>
      <dt>Professional skills</dt><dd>{strengths.join('; ')}.</dd>
      <dt>Digital skills</dt><dd>{stack.map((s) => s.value).join('; ')}.</dd>
    </dl>
  </section>
</article>

<style is:global>
  .eu { --ink:#1b2430; --mut:#5a6372; --eu:#0a4a9e; --line:#c9d3e3;
    font-family:"Inter Variable",system-ui,sans-serif; color:var(--ink); background:#fff; font-size:9.4pt; line-height:1.42; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
  .eu-top { border-bottom:2.5pt solid var(--eu); padding-bottom:7pt; margin-bottom:4pt; }
  .eu-mark { color:var(--eu); font-weight:700; font-size:11pt; margin:0 0 3pt; }
  .eu h1 { font-family:inherit; font-size:22pt; font-weight:600; margin:0; letter-spacing:-.02em; }
  .eu h2 { font-family:inherit; font-size:10pt; font-weight:700; color:var(--eu); margin:0 0 5pt; letter-spacing:0; }
  .eu h3 { font-family:inherit; font-size:9.8pt; font-weight:650; margin:0; letter-spacing:0; }
  .eu-sec { display:grid; grid-template-columns:42mm 1fr; gap:0 12pt; padding:9pt 0; border-bottom:.6pt solid var(--line); }
  .eu-sec > h2 { grid-column:1; margin:1pt 0 0; }
  .eu-sec > :not(h2) { grid-column:2; }
  .eu-item { display:grid; grid-template-columns:30mm 1fr; gap:0 10pt; margin-bottom:7pt; break-inside:avoid; }
  .eu-sec > .eu-item { grid-column:2; }
  .eu-when { margin:0; color:var(--mut); font-size:8.6pt; }
  .eu-body { margin:0 0 3pt; } .eu-body p { margin:0 0 2pt; }
  .eu-org { color:var(--mut); }
  .eu ul { margin:3pt 0 0; padding-left:11pt; list-style:disc; } .eu li { margin-bottom:2pt; } .eu li::marker { color:var(--eu); }
  .eu-dl { display:grid; grid-template-columns:30mm 1fr; gap:3pt 10pt; margin:0; } .eu-dl dt { font-weight:600; color:var(--mut); } .eu-dl dd { margin:0; }
  @media (max-width:640px){ .eu-sec { grid-template-columns:1fr; } .eu-sec > :not(h2), .eu-sec > h2 { grid-column:1; } .eu-item { grid-template-columns:1fr; } .eu-dl { grid-template-columns:1fr; } .eu-dl dd { margin-bottom:4pt; } .eu { font-size:10pt; } }
</style>
