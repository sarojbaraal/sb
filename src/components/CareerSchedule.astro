---
// A career drawn as a project schedule. Every bar comes from the CV dates.
// kind: edu = outlined, field = field engineering, core = main employer, now = current
const AXIS_START = 2005;
const now = new Date();
const nowFrac = now.getFullYear() + now.getMonth() / 12;
const AXIS_END = Math.ceil(nowFrac) + 1;
const span = AXIS_END - AXIS_START;

import { scheduleRows } from '../lib/cv';
const rows = scheduleRows;

const pct = (y: number) => ((y - AXIS_START) / span) * 100;
const ticks = [2005, 2010, 2015, 2020, 2025].filter((t) => t <= AXIS_END);
---

<figure class="sched" aria-labelledby="sched-title">
  <figcaption id="sched-title" class="font-display text-xl md:text-2xl text-[var(--color-text)] mb-5">
    My career, drawn the way I plan projects
  </figcaption>

  <div class="sched-axis" aria-hidden="true">
    <div></div>
    <div class="sched-axis-track">
      {ticks.map((t) => <span style={`left:${pct(t)}%`}>{t}</span>)}
    </div>
  </div>

  <div class="sched-body">
  <div class="sched-overlay" aria-hidden="true">
    <span class="sched-today" style={`left:${pct(nowFrac)}%`}></span>
  </div>
  <ol class="m-0 p-0 list-none">
    {rows.map((r, i) => {
      const left = pct(r.start);
      const width = Math.max(pct(r.end) - left, 1.1);
      const yearsOnRight = left + width < 78;
      return (
        <li class="sched-row" style={`--i:${i}`}>
          <div class="sched-label">
            {r.label}
            <small>{r.sub}</small>
          </div>
          <div class="sched-track">
            <span class={`sched-bar ${r.kind}`} style={`left:${left}%;width:${width}%`} aria-hidden="true" />
            <span
              class="sched-years"
              style={yearsOnRight ? `left:calc(${left + width}% + 8px)` : `right:calc(${100 - left}% + 8px)`}
            >
              {r.years}
            </span>
          </div>
        </li>
      );
    })}
  </ol>
  </div>
  <p class="text-[10px] text-[var(--color-muted)] mt-3 mb-0 italic">
    *The amber line marks today.
  </p>
</figure>
