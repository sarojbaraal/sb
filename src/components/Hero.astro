---
import { url } from "../utils/url";
import profile from "../data/profile.json";
import CareerSchedule from "./CareerSchedule.astro";
import ProofStrip from "./ProofStrip.astro";
---

<section class="pt-12 md:pt-20 pb-14 md:pb-20">
  <div class="site-container">
    <div class="hero-grid">
      <div>
        <p class="hero-kicker text-[15px] text-[var(--color-muted)] mb-5 flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-marigold)]" aria-hidden="true"></span>
          MIS · Business intelligence · Project control
        </p>

        <h1 class="hero-title max-w-[13ch] mb-6">
          Make every number useful.
        </h1>

        <p class="text-lg md:text-xl text-[var(--color-muted)] prose-measure mb-8 leading-[1.6]">
          I turn scattered operational data into <strong class="text-[var(--color-text)]">reports people trust, records teams can hand over and actions managers can see.</strong> Six years at Huawei Technologies Nepal, an engineering degree and an Executive MBA shape the way I work.
        </p>

        <div class="flex flex-wrap items-center gap-3 mb-8 md:mb-0">
          <a href={`mailto:${profile.email}`} class="btn-base btn-primary text-base px-5 py-2.5">Discuss a project</a>
          <a href={url("/cv")} class="btn-base btn-secondary text-base px-5 py-2.5">View CV</a>
          <a href={url("/work")} class="link-quiet text-base ml-1">See sample work</a>
        </div>
      </div>

      <div class="impact-board" aria-label="Illustrative reporting improvement from five days to four hours">
        <div class="impact-board-top">
          <div>
            <p class="preview-kicker">Field note / reporting intervention</p>
            <p class="impact-board-title">A better reporting rhythm.</p>
          </div>
          <span class="impact-board-number">01</span>
        </div>
        <div class="impact-metric">
          <div><strong>5 days</strong><span>before</span></div>
          <span class="impact-arrow" aria-hidden="true">→</span>
          <div class="impact-metric-after"><strong>4 hours</strong><span>after</span></div>
        </div>
        <p class="impact-caption">Illustrative cycle-time improvement from a unified monthly executive pack.</p>
        <div class="impact-bars" aria-hidden="true">
          <span style="--bar-height: 100%"></span><span style="--bar-height: 82%"></span><span style="--bar-height: 64%"></span><span class="is-active" style="--bar-height: 24%"></span>
        </div>
        <div class="impact-board-footer"><span>Inputs validated</span><span>Decision-ready</span></div>
      </div>
    </div>

    <CareerSchedule />
    <div class="mt-10 md:mt-12">
      <ProofStrip />
    </div>
  </div>
</section>
