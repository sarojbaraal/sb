---
import { url } from "../utils/url";
import BaseLayout from "../layouts/BaseLayout.astro";
import Timeline from "../components/Timeline.astro";
import profile from "../data/profile.json";
import cv from "../data/cv.json";

const principles = [
  ['Structure first', 'A clean, verified tracker beats a clever, fragile macro-heavy sheet.'],
  ['Define "done" before starting', 'Agree the output format, required fields and sign-off criteria up front.'],
  ['Write it down and follow up on gaps', 'Unrecorded assumptions turn into disputes. Keep one source register and close discrepancies promptly.'],
  ['Hand over something the team can run', 'A system only works if the people who inherit it can maintain it with confidence.'],
];
---

<BaseLayout
  title="About"
  description="Saroj Baral: electronics and communication engineer with experience in project coordination, MIS, reporting, SCM-related operations and independent freelance work."
>
  <div class="site-container py-14 md:py-20">
    <h1 class="max-w-[18ch] mb-6">Engineering discipline applied to business information.</h1>
    <p class="text-lg md:text-xl text-[var(--color-muted)] prose-measure mb-14">
      {profile.summary}
    </p>

    <div>
      <section class="rule-row">
        <h2 class="text-[1.5rem]">Engineering foundation</h2>
        <div class="prose-measure text-[var(--color-text)]">
          <p>
            I studied Electronics and Communication Engineering at Kathmandu Engineering College. My early field experience included an internship at Radio Nepal, working with broadcast equipment and signal quality, and a Survey Engineer role at GTL Nepal, assessing power supply and network status at BTS sites.
          </p>
          <p class="mb-0">
            Site work taught me to verify information rather than rely on assumptions, and to document findings so others can act on them. That discipline continues to shape how I approach reporting and coordination.
          </p>
        </div>
      </section>

      <section class="rule-row">
        <h2 class="text-[1.5rem]">Huawei Technologies Nepal, 2013 to 2019</h2>
        <div class="prose-measure text-[var(--color-text)]">
          <p>
            I spent six years at Huawei Technologies Nepal in roles spanning technical solutions, project coordination, project control and operations. My work included supporting client requirements and technical sales activities, coordinating with sales, finance, supply chain, vendors and delivery teams, and contributing to bid and proposal reviews.
          </p>
          <p class="mb-0">
            I also worked with MIS and ERP records, management reporting, BOQ-based material planning, SCM coordination and project documentation. In 2019, my team received a Certificate of Merit as a top-performing team at the WDM Golden Seeds Training Programme in Shenzhen.
          </p>
        </div>
      </section>

      <section class="rule-row">
        <h2 class="text-[1.5rem]">Business studies and independent work</h2>
        <div class="prose-measure text-[var(--color-text)]">
          <p>
            I completed an Executive MBA at Himalayan WhiteHouse International College in 2022, building on my engineering background with formal study in management and business operations.
          </p>
          <p class="mb-0">
            Since 2022, I have taken on independent freelance and project-based assignments through a combination of direct clients, referrals and online platforms. The work has included data research, information gathering, Excel-based data handling, data entry, reporting, business documentation and presentations.
          </p>
        </div>
      </section>

      <section class="rule-row">
        <h2 class="text-[1.5rem]">How I work</h2>
        <dl class="m-0 space-y-5 prose-measure">
          {principles.map(([term, text]) => (
            <div>
              <dt class="font-semibold text-[var(--color-text)]">{term}</dt>
              <dd class="m-0 text-[var(--color-muted)]">{text}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>

    <div class="mt-16 mb-4">
      <h2 class="mb-8">Career history</h2>
      <Timeline />
    </div>

    <section class="rule-row">
      <h2 class="text-[1.5rem]">Beyond work</h2>
      <div class="prose-measure text-[var(--color-text)]">
        <p>
          In 2015 I volunteered in earthquake relief and reconstruction across affected districts of Nepal, supporting temporary shelters, rebuilding work, sanitation and hygiene awareness, health camps and livelihood assistance.
        </p>
        <p>
          I am a devotee of Lord Shiva. <a href={url("/devotion")} class="link-quiet">Read a little about that here.</a>
        </p>
        <p class="mb-0 text-[var(--color-muted)]">
          Languages: {profile.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ')}.
        </p>
      </div>
    </section>

    <div class="pt-4 flex flex-wrap gap-3">
      <a href={url("/cv")} class="btn-base btn-primary px-5 py-2.5">View CV</a>
      <a href={url("/contact")} class="btn-base btn-secondary px-5 py-2.5">Contact me</a>
    </div>
  </div>
</BaseLayout>
