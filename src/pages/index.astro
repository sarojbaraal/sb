---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import cv from '../data/cv.json';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import profile from '../data/profile.json';
import { getCollection } from 'astro:content';

const workEntries = await getCollection('work');
const sortedWork = workEntries.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.headline,
    url: 'https://sarojbaral.com.np',
    email: profile.email,
    telephone: profile.phone,
    address: {
      '@type': 'PostalAddress',
      addressLocality: profile.location.city,
      addressCountry: profile.location.country,
    },
    sameAs: [profile.linkedin],
    description: profile.tagline,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Saroj Baral',
    url: 'https://sarojbaral.com.np',
    description: profile.headline,
  },
];
---

<BaseLayout
  title={`${profile.name} | MIS, Project Control & Business Operations`}
  description={`${profile.name}: ${profile.headline}. ${profile.tagline} Six years at Huawei Technologies Nepal, Executive MBA 2022, open to remote roles.`}
  jsonLd={jsonLd}
>
  <Hero />

  <!-- Navy band: About / Experience / What I do + values -->
  <div class="navyband">
    <svg class="divider" viewBox="0 0 1440 90" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0,90 L0,60 L210,10 C330,-6 430,44 580,50 C740,57 830,12 990,22 C1090,28 1150,66 1230,60 L1440,18 L1440,90 Z" />
    </svg>

    <section class="trio">
      <div class="site-container trio-grid">
        <div class="col glass about">
          <p class="eyebrow">About me</p>
          <h2>Where Engineering Meets Management &amp; Curiosity.</h2>
          <p>
            My professional journey spans electronics engineering, multinational project environments, and business management. These experiences have shaped my approach to solving problems, improving processes, and making information more reliable, meaningful, and actionable.
          </p>
          <p>I am particularly interested in bridging technology, business, and data to simplify complexity, support informed decision-making, and create practical value.</p>
          <p class="signature" aria-hidden="true">Saroj Baral</p>
        </div>

        <div class="col glass exp">
          <p class="eyebrow">Experience</p>
          <ol class="tl">
            <li class="now">
              <span class="dot"><Icon name="users" size={18} /></span>
              <div>
                <div class="row"><h3>Independent Professional</h3><span class="yrs">2022 &ndash; Present</span></div>
                <p class="role">MIS, Reporting &amp; Business Support</p>
                <p class="desc">Providing data management, reporting, online research, business documentation and project support, including ERP and supply chain-related assignments.</p>
              </div>
            </li>
            <li>
              <span class="dot"><Icon name="briefcase" size={18} /></span>
              <div>
                <div class="row"><h3>Huawei Technologies Nepal</h3><span class="yrs">2013 &ndash; 2019</span></div>
                <p class="role">Engineer, then Product Manager</p>
                <p class="desc">Coordinated IT solutions, project delivery, ERP reporting, SCM operations and cross-functional teams for major telecom projects.</p>
              </div>
            </li>
            <li>
              <span class="dot"><Icon name="network" size={18} /></span>
              <div>
                <div class="row"><h3>Early career</h3><span class="yrs">2010 &ndash; 2012</span></div>
                <p class="role">GTL Nepal, Radio Nepal</p>
                <p class="desc">Conducted BTS site assessments, evaluating power and network performance, and preparing technical reports with optimisation recommendations.</p>
              </div>
            </li>
          </ol>
          <a href={url("/experience")} class="btn-outline">View full experience <Icon name="arrow" size={16} /></a>
        </div>

        <div class="col glass what">
          <p class="eyebrow">What I do</p>
          <h2>I help businesses with</h2>
          <ul class="tiles">
            <li><span class="ti"><Icon name="chart" size={28} stroke={1.5} /></span><h3>MIS &amp; Reporting</h3><p>Structured reports and insights to support informed decisions.</p></li>
            <li><span class="ti"><Icon name="network" size={28} stroke={1.5} /></span><h3>Project Coordination</h3><p>Project planning, progress tracking and cross-team coordination.</p></li>
            <li><span class="ti"><Icon name="box" size={28} stroke={1.5} /></span><h3>ERP / SCM Support</h3><p>Operational data, material planning and supply chain documentation.</p></li>
            <li><span class="ti"><Icon name="search" size={28} stroke={1.5} /></span><h3>Research &amp; Analysis</h3><p>Reliable research, information gathering and structured analysis.</p></li>
            <li><span class="ti"><Icon name="sheet" size={28} stroke={1.5} /></span><h3>Excel &amp; Data Management</h3><p>Excel-based data organisation, validation and consolidation.</p></li>
            <li><span class="ti"><Icon name="doc" size={28} stroke={1.5} /></span><h3>Business Documentation</h3><p>Clear business reports, presentations and project documents.</p></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="values" aria-label="Working principles">
      <div class="site-container values-grid">
        <div class="val"><span class="vi"><Icon name="rocket" size={26} stroke={1.5} /></span><div><h3>Engineering Mindset</h3><p>Analytical, systematic and solution oriented.</p></div></div>
        <div class="val"><span class="vi"><Icon name="users" size={26} stroke={1.5} /></span><div><h3>Business Perspective</h3><p>Align technical execution with business strategy.</p></div></div>
        <div class="val"><span class="vi"><Icon name="target" size={26} stroke={1.5} /></span><div><h3>Results Focused</h3><p>Committed to accuracy, efficiency and impact.</p></div></div>
        <div class="val"><span class="vi"><Icon name="bulb" size={26} stroke={1.5} /></span><div><h3>Always Learning</h3><p>Curious, adaptable and open to new ideas.</p></div></div>
      </div>
    </section>
  </div>

  <!-- Recognition -->
  <section class="band">
    <div class="site-container">
      <p class="eyebrow">Recognition</p>
      <h2 class="band-title">Awards and appreciation from six years at Huawei</h2>
      <ul class="recs">
        {cv.recognition.map((r) => (
          <li class="rec">
            <span class="ri"><Icon name={r.icon} size={24} stroke={1.6} /></span>
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Other ways to work together -->
  <section class="band alt">
    <div class="site-container">
      <p class="eyebrow">Beyond a full-time role</p>
      <h2 class="band-title">Other ways to work with me</h2>
      <div class="ways">
        <article class="way">
          <span class="ri"><Icon name="lectern" size={24} stroke={1.6} /></span>
          <h3>Lectures and workshops</h3>
          <p>Engineering and management courses: electronics, communication, operations, project management, MIS and Excel for business. Visiting faculty, guest lectures and corporate training.</p>
          <a class="more" href={url("/teaching")}>Teaching details <Icon name="arrow" size={15} /></a>
        </article>
        <article class="way">
          <span class="ri"><Icon name="link" size={24} stroke={1.6} /></span>
          <h3>Business partnership</h3>
          <p>Open to partnerships where I contribute skills and time in return for a share in the business (sweat-equity). Operations, MIS, reporting and project control are what I can bring.</p>
          <a class="more" href={url("/contact?service=partnership")}>Discuss a partnership <Icon name="arrow" size={15} /></a>
        </article>
        <article class="way">
          <span class="ri"><Icon name="globe" size={24} stroke={1.6} /></span>
          <h3>High-Performance Business Websites</h3>
          <p>Clean, ultra-fast, and mobile-optimized digital assets engineered for local enterprises. Delivered fully functional within 7 to 10 days.
          </p>
          <a class="more" href={url("/websites")}>See packages <Icon name="arrow" size={15} /></a>
        </article>
      </div>
    </div>
  </section>

  <!-- Sample work -->
  <section class="band">
    <div class="site-container">
      <p class="eyebrow">Projects</p>
      <h2 class="band-title">Sample work</h2>
      <p class="band-sub">Worked examples on dummy data that show how I structure a reporting pack, register or tracker. They are samples of method, not client results.</p>
      <div class="cards">
        {sortedWork.map((entry) => (
          <CaseStudyCard
            slug={entry.id}
            title={entry.data.title}
            summary={entry.data.summary}
            client_type={entry.data.client_type}
            year={entry.data.year}
            services={entry.data.services}
            tools={entry.data.tools}
            result_metrics={entry.data.result_metrics}
            cover={entry.data.cover}
          />
        ))}
      </div>
      <a href={url("/work")} class="more">All sample work <Icon name="arrow" size={15} /></a>
    </div>
  </section>

  <!-- Contact -->
  <section class="cta">
    <div class="site-container cta-in">
      <div>
        <h2>Hiring for a remote project or MIS role?</h2>
        <p>Open to remote roles in MIS, project control, data operations and project coordination. Based in Nepal (NPT, UTC+5:45).</p>
      </div>
      <div class="cta-actions">
        <a href={`mailto:${profile.email}`} class="btn-solid"><Icon name="mail" size={16} /> Email me</a>
        <a href={url("/cv/Saroj-Baral-Modern-Resume.pdf")} download class="btn-line"><Icon name="download" size={16} /> Download CV</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .eyebrow { color: var(--color-accent); font-size: 12.5px; font-weight: 600; letter-spacing: 0.09em; text-transform: uppercase; margin: 0 0 18px; position: relative; padding-bottom: 12px; }
  .eyebrow::after { content: ""; position: absolute; left: 0; bottom: 0; width: 22px; height: 2px; background: var(--color-accent); }

  /* Navy band: one continuous gradient, both themes */
  .navyband { position: relative; color: #fff; padding-top: 1px;
    background:
      radial-gradient(60% 45% at 18% 48%, rgba(47, 111, 237, 0.16), transparent 70%),
      radial-gradient(50% 45% at 88% 70%, rgba(47, 111, 237, 0.12), transparent 70%),
      linear-gradient(180deg, #0A1636 0%, #0B1D45 55%, #08122B 100%); }
  .divider { position: absolute; left: 0; right: 0; top: -89px; width: 100%; height: 90px; display: block; fill: #0A1636; pointer-events: none; }
  .navyband .eyebrow { color: var(--blue-bright); }
  .navyband .eyebrow::after { background: var(--blue-bright); }

  .trio { padding: 0 0 40px; margin-top: -22px; position: relative; }
  .trio-grid { display: grid; grid-template-columns: 1fr; gap: 20px; }
  .glass { background: linear-gradient(155deg, rgba(255,255,255,0.09) 0%, rgba(255,255,255,0.04) 55%, rgba(255,255,255,0.05) 100%);
    border: 1px solid rgba(255,255,255,0.13); border-radius: 8px; box-shadow: 0 10px 30px rgba(2, 8, 24, 0.35), inset 0 1px 0 rgba(255,255,255,0.08); }
  .col { padding: 32px 28px; }
  .col h2 { font-size: clamp(1.45rem, 2.2vw, 1.8rem); line-height: 1.22; margin: 0 0 18px; color: #fff; max-width: 20ch; }
  .about p:not(.eyebrow):not(.signature) { font-size: 14.5px; line-height: 1.75; color: #CBD5EA; max-width: 46ch; margin: 0 0 12px; text-align: justify; text-justify: inter-word; hyphens: auto; -webkit-hyphens: auto; hyphenate-limit-chars: 6 3 3; }
  .signature { font-family: var(--font-script); font-size: 3rem; line-height: 1; color: #7FB0FF; margin: 22px 0 0 !important; transform: rotate(-3deg); transform-origin: left; }

  .exp { background: linear-gradient(155deg, rgba(47,111,237,0.20) 0%, rgba(255,255,255,0.05) 60%, rgba(255,255,255,0.05) 100%); border-color: rgba(127,176,255,0.30); }
  .tl { list-style: none; margin: 0 0 26px; padding: 0; position: relative; }
  .tl::before { content: ""; position: absolute; left: 17px; top: 20px; bottom: 28px; width: 2px; background: linear-gradient(180deg, rgba(127,176,255,0.9), rgba(127,176,255,0.15)); border-radius: 2px; }
  .tl li { display: grid; grid-template-columns: 36px 1fr; gap: 16px; padding: 0 0 24px; position: relative; }
  .tl li:last-child { padding-bottom: 0; }
  .dot { width: 36px; height: 36px; border-radius: 50%; background: #11265A; border: 1.5px solid rgba(127,176,255,0.7); color: #A9CBFF; display: inline-flex; align-items: center; justify-content: center; z-index: 1; }
  .tl li.now .dot { background: var(--btn-bg); border-color: #9FC2FF; color: #fff; box-shadow: 0 0 0 5px rgba(47,111,237,0.22); }
  .row { display: flex; justify-content: space-between; align-items: baseline; gap: 4px 12px; flex-wrap: wrap; }
  .exp h3 { color: #fff; font-size: 1rem; margin: 0; }
  .yrs { font-size: 12.5px; color: #C3D0EA; white-space: nowrap; }
  .role { color: #8DBBFF; font-size: 14px; font-weight: 500; margin: 2px 0 5px; }
  .desc { font-size: 13.5px; line-height: 1.6; color: #C5CFE6; margin: 0; max-width: 46ch; }
  .btn-outline { display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; border: 1px solid rgba(255,255,255,.35); border-radius: 3px; color: #fff; text-decoration: none; font-size: 12.5px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .btn-outline:hover { border-color: #fff; background: rgba(255,255,255,.08); }

  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 18px; }
  .tiles li { padding: 18px 0; border-top: 1px solid rgba(255,255,255,0.12); }
  .ti { display: block; color: #7FB0FF; margin-bottom: 10px; }
  .tiles h3 { font-size: 0.95rem; margin: 0 0 5px; color: #fff; }
  .tiles p { font-size: 13px; line-height: 1.55; color: #BFCBE3; margin: 0; }

  .values { padding: 26px 0 34px; border-top: 1px solid rgba(255,255,255,0.08); background: rgba(3, 9, 26, 0.35); }
  .values-grid { display: grid; grid-template-columns: 1fr; gap: 22px; }
  .val { display: flex; gap: 16px; align-items: center; }
  .vi { flex: none; width: 52px; height: 52px; border-radius: 50%; background: rgba(47,111,237,0.18); border: 1px solid rgba(127,176,255,0.35); color: #8DBBFF; display: inline-flex; align-items: center; justify-content: center; }
  .val h3 { color: #fff; font-size: .95rem; margin: 0 0 3px; }
  .val p { color: #BFCBE3; font-size: 13px; line-height: 1.5; margin: 0; }

  .band { padding: 64px 0; background: var(--color-bg); }
  .band.alt { background: var(--color-surface); border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); }
  .band-title { margin: 0 0 12px; }
  .band-sub { color: var(--color-muted); max-width: 62ch; margin: 0 0 28px; }
  .recs, .ways, .cards { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: 1fr; gap: 18px; }
  .cards { margin-top: 0; margin-bottom: 26px; }
  .rec, .way { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: 8px; padding: 24px; }
  .band.alt .way { background: var(--color-bg); }
  .ri { display: inline-flex; width: 46px; height: 46px; border-radius: 50%; align-items: center; justify-content: center; background: var(--color-accent-soft); color: var(--color-accent); margin-bottom: 14px; }
  .rec h3, .way h3 { font-size: 1.02rem; margin: 0 0 8px; }
  .rec p, .way p { font-size: 14px; line-height: 1.65; color: var(--color-muted); margin: 0 0 12px; }
  .rec p { margin: 0; }
  .more { display: inline-flex; align-items: center; gap: 8px; color: var(--color-accent); font-weight: 600; font-size: 14px; text-decoration: none; }
  .more:hover { text-decoration: underline; text-underline-offset: 4px; }

  .cta { background: linear-gradient(100deg, var(--navy-950), var(--navy-800)); color: #fff; padding: 56px 0; }
  .cta-in { display: grid; gap: 24px; align-items: center; }
  .cta h2 { color: #fff; margin: 0 0 10px; }
  .cta p { color: #C5CEE0; margin: 0; max-width: 56ch; }
  .cta-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-solid, .btn-line { display: inline-flex; align-items: center; gap: 10px; padding: 13px 20px; border-radius: 3px; text-decoration: none; font-size: 13px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; }
  .btn-solid { background: var(--btn-bg); color: #fff; border: 1px solid var(--btn-bg); }
  .btn-solid:hover { background: var(--btn-bg-hover); }
  .btn-line { border: 1px solid rgba(255,255,255,.4); color: #fff; }
  .btn-line:hover { background: rgba(255,255,255,.08); border-color: #fff; }

  @media (min-width: 640px) { .recs { grid-template-columns: repeat(2, 1fr); } .values-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 900px) {
    .ways, .cards { grid-template-columns: repeat(3, 1fr); }
    .cta-in { grid-template-columns: 1fr auto; }
  }
  @media (min-width: 768px) and (max-width: 1199px) {
    .trio-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
    .exp { grid-column: 1 / -1; order: 3; }
    .values-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1100px) {
    .trio-grid { grid-template-columns: 0.95fr 1.1fr 1.2fr; gap: 24px; align-items: stretch; }
    .col { padding: 38px 34px; }
    .divider { top: -119px; height: 120px; }
    .trio { margin-top: -34px; }
    .recs { grid-template-columns: repeat(4, 1fr); }
    .values-grid { grid-template-columns: repeat(4, 1fr); gap: 0; }
    .val { padding: 0 24px; border-left: 1px solid rgba(255,255,255,0.12); }
    .val:first-child { border-left: 0; padding-left: 0; }
  }
</style>
