---
import { url } from "../../utils/url";
import { splitKpi } from "../../utils/kpi";
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const workEntries = await getCollection('work');
  return workEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const kpi = entry.data.kpi;
const from = kpi?.from ? splitKpi(kpi.from) : null;
const to = kpi ? splitKpi(kpi.to) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.summary,
  author: {
    '@type': 'Person',
    name: 'Saroj Baral',
  },
  publisher: {
    '@type': 'Person',
    name: 'Saroj Baral',
  },
};
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.summary}
  type="article"
  jsonLd={jsonLd}
>
  <article class="site-container section-padding">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm" aria-label="Breadcrumb">
      <a href={url("/work")} class="link-arrow" style="font-size:0.875rem">
        <span aria-hidden="true">&larr;</span> All work samples
      </a>
    </nav>

    <!-- Header -->
    <header class="max-w-3xl mb-8">
      <p class="eyebrow">{entry.data.client_type} &middot; {entry.data.year}</p>
      <h1 class="mb-4" style="font-size:clamp(2rem,4.4vw,2.75rem)">{entry.data.title}</h1>
      <p class="lead m-0">{entry.data.summary}</p>
    </header>

    <!-- Key result -->
    {kpi && to && (
      <div class="card-base max-w-3xl mb-6 work-card__kpi" style="border-bottom:1px solid var(--color-border)">
        <p class="kpi-eyebrow"><span>Key result</span><span>Illustrative sample</span></p>
        <p class="kpi-value">
          {from && (
            <>
              <span class="from">{from.prefix}{from.num}{from.suffix}</span>
              <Icon name="arrow-right" size={22} class="arrow" />
            </>
          )}
          <span class="to">{to.prefix}{to.num}{to.suffix}</span>
        </p>
        <p class="kpi-label">{kpi.label}</p>
      </div>
    )}

    <!-- Meta: services + tools -->
    <div class="max-w-3xl mb-8 pb-8 border-b border-[var(--color-border)] space-y-3">
      <div class="tag-row items-center">
        <span class="text-xs font-semibold text-[var(--color-subtle)] mr-1">Services</span>
        {entry.data.services.map((svc) => <span class="tag tag--accent">{svc}</span>)}
      </div>
      <div class="tag-row items-center">
        <span class="text-xs font-semibold text-[var(--color-subtle)] mr-1">Tools</span>
        {entry.data.tools.map((tool) => <span class="tag">{tool}</span>)}
      </div>
    </div>

    <!-- Mandatory visible notice -->
    <div class="max-w-3xl mb-8 p-4 rounded-lg bg-[var(--color-surface)] border border-[var(--color-border)] text-sm text-[var(--color-muted)]" style="border-left:4px solid var(--color-accent)">
      <strong class="text-[var(--color-text)]">Notice:</strong> Illustrative case study with anonymized data.
    </div>

    <!-- Optional sample download -->
    {entry.data.sample_file && (
      <div class="card-base max-w-3xl mb-10 p-4 flex flex-wrap items-center justify-between gap-3">
        <div class="text-sm font-medium">Download the illustrative data schema outline</div>
        <a href={url(entry.data.sample_file)} download class="btn-base btn-primary btn-sm">
          <Icon name="download" size={15} /> Download sample
        </a>
      </div>
    )}

    <!-- MDX body. Each study ends with its own service-specific call to action. -->
    <div class="max-w-3xl prose-content">
      <Content />
    </div>
  </article>
</BaseLayout>
