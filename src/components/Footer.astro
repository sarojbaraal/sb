---
import { url } from "../utils/url";
import profile from '../data/profile.json';

const currentYear = new Date().getFullYear();
const pages = [
  ['/about', 'About'],
  ['/services', 'Services'],
  ['/work', 'Work'],
  ['/cv', 'CV'],
  ['/devotion', 'Beyond work'],
];
---

<footer class="site-footer">
  <div class="site-container">
    <div class="site-footer__grid">
      <div>
        <a href={url("/")} class="brand" aria-label="Saroj Baral, home">
          <span class="brand__mark" aria-hidden="true">SB</span>
          <span>{profile.name}</span>
        </a>
        <p class="footer-tag">{profile.tagline}</p>
      </div>

      <nav aria-label="Footer">
        <p class="footer-title">Pages</p>
        <ul class="footer-links">
          {pages.map(([href, label]) => (
            <li><a href={url(href)}>{label}</a></li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="footer-title">Get in touch</p>
        <ul class="footer-links">
          <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
          <li><a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={url("/contact")}>Contact form</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p class="m-0">&copy; {currentYear} {profile.name}</p>
      <a href={url("/privacy")}>Privacy policy</a>
    </div>
  </div>
</footer>
