---
interface Props {
  name: string;
  price: string;
  featured?: boolean;
  features: string[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  name,
  price,
  featured = false,
  features = [],
  ctaText = 'Request quote →',
  ctaHref = '/contact?service=website',
} = Astro.props;
---

<div class={`card-base p-6 md:p-8 flex flex-col justify-between relative transition-all ${
  featured ? 'border-2 border-[var(--color-accent)] shadow-md bg-[var(--color-surface)]' : 'bg-[var(--color-surface)]'
}`}>
  {featured && (
    <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-[var(--color-accent)] text-white text-[11px] font-bold uppercase tracking-wider px-3 py-0.5 rounded-full shadow-sm">
      Most Popular
    </div>
  )}

  <div>
    <!-- Package Name -->
    <h3 class="text-xl font-bold text-[var(--color-text)] mb-2">
      {name}
    </h3>

    <!-- Price -->
    <div class="mb-6 pb-6 border-b border-[var(--color-border)]">
      <div class="text-3xl font-bold text-[var(--color-text)]">
        {price}
      </div>
      <span class="text-xs text-[var(--color-muted)]">Fixed quote · 7–10 days turnaround</span>
    </div>

    <!-- Features -->
    <ul class="space-y-3 mb-8 text-sm">
      {features.map((feature) => (
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-[var(--color-accent)] mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          <span class="text-[var(--color-text)] font-medium">{feature}</span>
        </li>
      ))}
    </ul>
  </div>

  <!-- Action CTA -->
  <div>
    <a
      href={ctaHref}
      class={`btn-base w-full text-center ${
        featured ? 'btn-primary' : 'btn-secondary'
      }`}
    >
      {ctaText}
    </a>
  </div>
</div>

