---
import { url } from "../utils/url";
import Icon from "./Icon.astro";

interface Props {
  id: string;
  label: string;
  icon?: string;
  title: string;
  priceFrom?: string;
  engagement?: string;
  bullets?: string[];
  ctaText?: string;
  ctaHref?: string;
}

const {
  id,
  label,
  icon = 'chart-column',
  title,
  priceFrom,
  engagement,
  bullets = [],
  ctaText = 'Learn more',
  ctaHref = `/services#${id}`,
} = Astro.props;
---

<div id={id} class="card-base card-hover p-6 md:p-7 flex flex-col justify-between h-full scroll-mt-24">
  <div>
    <div class="flex items-center justify-between mb-5">
      <span class="icon-tile"><Icon name={icon} size={22} /></span>
      <span class="text-sm font-semibold text-[var(--color-subtle)]">Service {label}</span>
    </div>

    <h3 class="text-xl font-semibold mb-3">{title}</h3>

    {(priceFrom || engagement) && (
      <div class="mb-5 pb-5 border-b border-[var(--color-border)]">
        {priceFrom && <span class="block font-semibold text-[var(--color-accent)]">{priceFrom}</span>}
        {engagement && <span class="block text-sm text-[var(--color-muted)]">{engagement}</span>}
      </div>
    )}

    {bullets.length > 0 && (
      <ul class="space-y-3 mb-7 text-[15px] text-[var(--color-muted)] list-none p-0">
        {bullets.map((bullet) => (
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={16} strokeWidth={2.5} class="mt-1 shrink-0 text-[var(--color-accent)]" />
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <a href={url(ctaHref)} class="btn-base btn-primary w-full text-sm">
    {ctaText}
    <Icon name="arrow-right" size={16} />
  </a>
</div>
