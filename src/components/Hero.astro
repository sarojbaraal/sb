---
import { url } from "../utils/url";
import profile from "../data/profile.json";
import Icon from "./Icon.astro";

const kpi = { label: "Reporting workflow", from: "5 days", to: "4 hours" };
---

<section class="hero hero--showcase" aria-labelledby="hero-title">
  <div class="site-container hero__grid">
    <div class="hero__copy">
      <p class="hero__eyebrow hero-in" style="--d:0ms">
        <span class="hero__eyebrow-dot" aria-hidden="true"></span>
        MIS · BUSINESS INTELLIGENCE · PROJECT COORDINATION
      </p>

      <h1 id="hero-title" class="hero__title hero-in" style="--d:60ms">
        Turning information<br />into <span>clarity.</span>
      </h1>
      <p class="hero__role hero-in" style="--d:110ms">{profile.headline}</p>
      <p class="hero__summary hero-in" style="--d:160ms">
        Engineer by background. Business professional by experience. I help teams make sense of information, streamline processes and keep projects moving with dependable reporting and coordination.
      </p>

      <div class="hero__proof hero-in" style="--d:190ms">
        <span><Icon name="map-pin" size={15} /> {profile.location.city}, {profile.location.country}</span>
        <span><Icon name="briefcase-business" size={15} /> 6 years at Huawei</span>
        <span><Icon name="graduation-cap" size={15} /> Executive MBA</span>
      </div>

      <div class="hero__actions hero-in" style="--d:230ms">
        <a href={url("/cv")} class="btn-base btn-primary">
          View my CV <Icon name="arrow-right" size={16} />
        </a>
        <a href={url("/contact")} class="btn-base hero__contact">
          Contact me <Icon name="arrow-up-right" size={16} />
        </a>
      </div>
    </div>

    <div class="hero__visual">
      <div class="hero__portrait-glow" aria-hidden="true"></div>
      <img
        class="hero__photo"
        src={url("/images/saroj-portrait.webp")}
        width="720"
        height="900"
        alt="Saroj Baral smiling in a navy blazer and white shirt"
        fetchpriority="high"
        decoding="async"
      />
      <aside class="kpi-card" aria-label="Illustrative reporting workflow example">
        <span class="kpi-card__icon"><Icon name="chart-no-axes-combined" size={18} /></span>
        <p class="kpi-card__label">{kpi.label}</p>
        <p class="kpi-card__value">
          <span class="from">{kpi.from}</span>
          <Icon name="arrow-right" size={14} class="arrow" />
          <span class="to">{kpi.to}</span>
        </p>
        <p class="kpi-card__note">Illustrative workflow example</p>
      </aside>
    </div>
  </div>
</section>
