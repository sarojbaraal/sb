---
import { url, stripBase } from "../utils/url";
import Icon from "./Icon.astro";

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/skills', label: 'Skills' },
  { href: '/work', label: 'Projects' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(href + '/'));
---

<header class="site-header">
  <div class="site-container nav-row">
    <a href={url("/")} class="brand" aria-label="Saroj Baral, home">SAROJ <span>BARAL</span></a>

    <nav class="nav-links" aria-label="Main navigation">
      {navLinks.map((link) => (
        <a href={url(link.href)} class:list={['nav-link', { active: isActive(link.href) }]} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav-tools">
      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch between light and dark theme" aria-pressed="false">
        <span class="knob"></span>
        <Icon name="sun" size={16} class="sun" />
        <Icon name="moon" size={16} class="moon" />
      </button>

      <button
        type="button"
        id="menu-toggle-btn"
        class="menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu-dialog"
      >
        <svg id="menu-icon-open" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        <svg id="menu-icon-close" class="hidden" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg>
      </button>
    </div>
  </div>

  <dialog id="mobile-menu-dialog" class="mobile-dialog">
    <nav class="mobile-nav" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a href={url(link.href)} class:list={['mobile-nav-link', { active: isActive(link.href) }]}>{link.label}</a>
      ))}
    </nav>
  </dialog>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 40;
    background: rgba(5, 11, 24, 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--navy-line);
    color: #fff;
  }
  .nav-row { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 24px; }
  .brand { font-weight: 700; font-size: 1.15rem; letter-spacing: 0.02em; color: #fff; text-decoration: none; white-space: nowrap; }
  .brand span { color: var(--blue-bright); }
  .nav-links { display: none; align-items: center; gap: 30px; }
  .nav-link {
    font-size: 13px; font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase;
    color: #D3DBEA; text-decoration: none; padding: 22px 0 19px; border-bottom: 2px solid transparent;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: #fff; }
  .nav-link.active { color: #fff; border-bottom-color: var(--blue-bright); }
  .nav-tools { display: flex; align-items: center; gap: 12px; }

  .theme-toggle {
    position: relative; width: 52px; height: 28px; border-radius: 999px; cursor: pointer;
    background: #17233F; border: 1px solid rgba(255, 255, 255, 0.18);
    display: flex; align-items: center; justify-content: space-between; padding: 0 7px; color: #AEBBD6;
  }
  .theme-toggle .knob {
    position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%;
    background: #fff; transition: transform 0.18s ease;
  }
  .theme-toggle .sun, .theme-toggle .moon { position: relative; z-index: 1; }
  :global(:root[data-theme="dark"]) .theme-toggle .knob { transform: translateX(24px); }
  :global(:root[data-theme="dark"]) .theme-toggle { background: #1F3566; }
  .theme-toggle .sun { color: #0F1B33; }
  :global(:root[data-theme="dark"]) .theme-toggle .sun { color: #AEBBD6; }
  :global(:root[data-theme="dark"]) .theme-toggle .moon { color: #0F1B33; }

  .menu-btn { color: #fff; padding: 6px; border-radius: 6px; background: none; border: 0; cursor: pointer; }
  .hidden { display: none; }

  .mobile-dialog {
    width: 100%; max-width: none; margin: 0; padding: 0; background: var(--navy-950); color: #fff;
    border: 0; border-bottom: 1px solid var(--navy-line);
  }
  .mobile-dialog::backdrop { background: rgba(0, 0, 0, 0.5); }
  .mobile-nav { display: flex; flex-direction: column; padding: 8px 24px 20px; }
  .mobile-nav-link {
    color: #D3DBEA; text-decoration: none; padding: 14px 0; font-size: 14px; font-weight: 500;
    letter-spacing: 0.04em; text-transform: uppercase; border-bottom: 1px solid var(--navy-line);
  }
  .mobile-nav-link.active { color: #fff; }

  @media (min-width: 960px) {
    .nav-links { display: flex; }
    .menu-btn { display: none; }
  }
</style>

<script>
  const btn = document.getElementById('menu-toggle-btn');
  const dialog = document.getElementById('mobile-menu-dialog') as HTMLDialogElement | null;
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function toggleMenu(open?: boolean) {
    if (!dialog || !btn) return;
    const shouldOpen = open ?? !dialog.open;
    if (shouldOpen) dialog.show(); else dialog.close();
    btn.setAttribute('aria-expanded', String(shouldOpen));
    iconOpen?.classList.toggle('hidden', shouldOpen);
    iconClose?.classList.toggle('hidden', !shouldOpen);
  }
  btn?.addEventListener('click', () => toggleMenu());
  document.querySelectorAll('.mobile-nav-link').forEach((l) => l.addEventListener('click', () => toggleMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggleMenu(false); });

  const root = document.documentElement;
  const themeBtn = document.getElementById('theme-toggle');
  const sync = () => themeBtn?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  themeBtn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
    sync();
  });
</script>
