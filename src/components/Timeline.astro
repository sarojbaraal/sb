---
import experience from '../data/experience.json';
---

<div class="relative border-l-2 border-[var(--color-border)] ml-3 md:ml-4 pl-6 md:pl-8 space-y-12">
  {experience.map((item) => (
    <div class="relative group">
      <!-- Dot on timeline -->
      <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-3.5 h-3.5 rounded-full bg-[var(--color-surface)] border-2 border-[var(--color-accent)] group-hover:bg-[var(--color-accent)] transition-colors" aria-hidden="true"></div>

      <!-- Header: Dates & Location -->
      <div class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)] mb-1">
        <span class="text-[var(--color-accent)]">{item.start} — {item.end}</span>
        <span>&bull;</span>
        <span>{item.location}</span>
      </div>

      <!-- Role & Organization -->
      <h3 class="text-xl font-bold text-[var(--color-text)] mb-0.5">
        {item.role}
      </h3>
      <div class="text-sm font-medium text-[var(--color-muted)] mb-3">
        {item.org}
      </div>

      <!-- Summary -->
      <p class="text-sm text-[var(--color-text)] mb-4 leading-relaxed font-normal">
        {item.summary}
      </p>

      <!-- Achievement Bullets -->
      {item.bullets && item.bullets.length > 0 && (
        <ul class="space-y-2 mb-4 text-sm text-[var(--color-muted)]">
          {item.bullets.map((bullet) => (
            <li class="flex items-start gap-2">
              <span class="text-[var(--color-accent)] font-bold shrink-0 mt-0.5">&ndash;</span>
              <span>{bullet}</span>
            </li>
          ))}
        </ul>
      )}

      <!-- Awards & Certifications if present -->
      {item.awards && item.awards.length > 0 && (
        <div class="mt-4 pt-3 border-t border-[var(--color-border)]/60">
          <span class="text-xs font-semibold text-[var(--color-accent)] block mb-2">Key Recognition:</span>
          <div class="flex flex-wrap gap-1.5">
            {item.awards.map((award) => (
              <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-[var(--color-accent-soft)] text-[var(--color-accent-hover)] border border-[var(--color-accent)]/20">
                {award}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  ))}
</div>

