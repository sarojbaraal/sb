---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found"
  description="The page you requested could not be found."
>
  <div class="site-container section-padding flex items-center justify-center min-h-[50vh]">
    <div class="card-base p-8 md:p-12 bg-[var(--color-surface)] text-center max-w-lg mx-auto shadow-sm">
      <span class="text-4xl md:text-5xl font-black text-[var(--color-accent)] block mb-3">
        404
      </span>

      <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--color-text)] mb-3">
        Page not found.
      </h1>

      <p class="text-base text-[var(--color-muted)] leading-relaxed mb-8">
        The link you followed may be outdated, or the page may have been moved.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={url("/")} class="btn-base btn-primary text-sm px-4 py-2">
          Home
        </a>
        <a href={url("/work")} class="btn-base btn-secondary text-sm px-4 py-2">
          Work
        </a>
        <a href={url("/contact")} class="btn-base btn-secondary text-sm px-4 py-2">
          Contact
        </a>
      </div>
    </div>
  </div>
</BaseLayout>

