---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, intro, align = 'left' } = Astro.props;
---

<div class={`mb-8 md:mb-12 ${align === 'center' ? 'text-center mx-auto max-w-2xl' : 'max-w-3xl'}`}>
  {eyebrow && (
    <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-accent)] block mb-2">
      {eyebrow}
    </span>
  )}
  <h2 class="text-2xl md:text-3xl font-semibold tracking-tight text-[var(--color-text)] mb-3">
    {title}
  </h2>
  {intro && (
    <p class="text-base md:text-lg text-[var(--color-muted)] leading-relaxed">
      {intro}
    </p>
  )}
</div>

