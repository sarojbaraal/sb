---
import experience from '../data/experience.json';
---

<ol class="list-none p-0 m-0">
  {experience.map((item) => (
    <li class="rule-row">
      <div>
        <p class="font-display text-xl text-[var(--color-text)] m-0">{item.start}&ndash;{item.end}</p>
        <p class="text-sm text-[var(--color-muted)] m-0">{item.location}</p>
      </div>

      <div>
        <h3 class="mb-0.5">{item.role}</h3>
        <p class="text-[15px] font-medium text-[var(--color-muted)] mb-3">{item.org}</p>
        <p class="text-[15px] text-[var(--color-text)] mb-4 prose-measure">{item.summary}</p>

        {'groups' in item && item.groups ? (
          <div class="space-y-5">
            {item.groups.map((g) => (
              <div>
                <p class="font-semibold text-[15px] text-[var(--color-text)] mb-1.5">{g.title}</p>
                <ul class="space-y-1.5 text-[15px] text-[var(--color-muted)] pl-5 list-disc prose-measure">
                  {g.bullets.map((b) => <li>{b}</li>)}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          item.bullets && (
            <ul class="space-y-1.5 text-[15px] text-[var(--color-muted)] pl-5 list-disc prose-measure">
              {item.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )
        )}

        {item.awards && item.awards.length > 0 && (
          <p class="mt-5 text-[15px] text-[var(--color-text)] prose-measure border-l-2 border-[var(--color-marigold)] pl-3">
            {item.awards.join(' ')}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>
