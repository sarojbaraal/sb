---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile.json';
import experience from '../data/experience.json';
import education from '../data/education.json';
import cv from '../data/cv.json';
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae of Saroj Baral: project control, MIS and business operations. Six years at Huawei Technologies Nepal, Executive MBA, independent consultant."
>
  <div class="site-container py-12 md:py-16">
    <div class="no-print flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-6 border-b border-[var(--color-border)]">
      <div>
        <h1 class="mb-2">Curriculum vitae</h1>
        <p class="text-[var(--color-muted)] m-0">Read it here, or download the two-page PDF.</p>
      </div>
      <div class="flex items-center gap-3">
        <a href={url("/cv/Saroj-Baral-CV.pdf")} download="Saroj-Baral-CV.pdf" class="btn-base btn-primary px-4 py-2">Download PDF</a>
        <button type="button" onclick="window.print()" class="btn-base btn-secondary px-4 py-2">Print</button>
      </div>
    </div>

    <article class="max-w-[820px]">
      <header class="mb-10">
        <h2 class="text-[2.4rem] mb-1">{profile.name}</h2>
        <p class="text-lg text-[var(--color-muted)] mb-3">{profile.headline}</p>
        <p class="text-[15px] text-[var(--color-muted)] m-0">
          {profile.location.city}, {profile.location.country} &nbsp;|&nbsp;
          <a class="link-quiet" href={`mailto:${profile.email}`}>{profile.email}</a> &nbsp;|&nbsp;
          <a class="link-quiet" href={`tel:${profile.phone}`}>{profile.phone}</a> &nbsp;|&nbsp;
          <a class="link-quiet" href={profile.linkedin}>LinkedIn</a>
        </p>
      </header>

      <section class="mb-10 page-break-avoid">
        <h3 class="mb-3">Summary</h3>
        <p class="prose-measure mb-4">{profile.summary}</p>
        <ul class="space-y-1.5 pl-5 list-disc text-[15px] prose-measure">
          {cv.strengths.map((s) => <li>{s}</li>)}
        </ul>
      </section>

      <section class="mb-10">
        <h3 class="mb-5">Experience</h3>
        <div class="space-y-9">
          {experience.map((job) => (
            <div class="page-break-avoid">
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <h4 class="font-semibold text-[1.05rem] m-0">{job.role}</h4>
                <span class="text-sm text-[var(--color-muted)]">{job.start} to {job.end}</span>
              </div>
              <p class="text-[15px] text-[var(--color-muted)] mb-2">{job.org}, {job.location}</p>
              {'groups' in job && job.groups ? (
                job.groups.map((g) => (
                  <div class="mb-3">
                    <p class="font-semibold text-[15px] mb-1">{g.title}</p>
                    <ul class="space-y-1 pl-5 list-disc text-[15px] text-[var(--color-muted)]">
                      {g.bullets.map((b) => <li>{b}</li>)}
                    </ul>
                  </div>
                ))
              ) : (
                <ul class="space-y-1 pl-5 list-disc text-[15px] text-[var(--color-muted)]">
                  {job.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
              {job.awards && <p class="text-[15px] mt-3 border-l-2 border-[var(--color-marigold)] pl-3 mb-0">{job.awards.join(' ')}</p>}
            </div>
          ))}
        </div>
      </section>

      <section class="mb-10 page-break-avoid">
        <h3 class="mb-4">Education</h3>
        <div class="space-y-4">
          {education.map((e) => (
            <div>
              <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1">
                <p class="font-semibold m-0">{e.degree}</p>
                <span class="text-sm text-[var(--color-muted)]">{e.start} to {e.end}</span>
              </div>
              <p class="text-[15px] text-[var(--color-muted)] m-0">{e.institution}, {e.location}</p>
              <p class="text-[15px] text-[var(--color-muted)] m-0">{e.summary}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="mb-10 page-break-avoid">
        <h3 class="mb-3">Tools and systems</h3>
        <dl class="m-0 space-y-1.5 text-[15px]">
          {cv.stack.map((s) => (
            <div class="grid sm:grid-cols-[13rem_1fr] gap-x-4">
              <dt class="font-semibold">{s.label}</dt>
              <dd class="m-0 text-[var(--color-muted)]">{s.value}</dd>
            </div>
          ))}
        </dl>
      </section>

      <section class="mb-10 page-break-avoid">
        <h3 class="mb-3">Volunteering</h3>
        <p class="font-semibold m-0">{cv.volunteer.title}, {cv.volunteer.place} ({cv.volunteer.year})</p>
        <p class="text-[15px] text-[var(--color-muted)] prose-measure m-0">{cv.volunteer.text}</p>
      </section>

      <section class="page-break-avoid">
        <h3 class="mb-3">Languages</h3>
        <p class="text-[15px] m-0">
          {profile.languages.map((l) => `${l.name} (${l.level.toLowerCase()})`).join(', ')}. References available on request.
        </p>
      </section>
    </article>
  </div>
</BaseLayout>
