---
import { url } from "../utils/url";
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import ServiceSummary from '../components/ServiceSummary.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import Icon from '../components/Icon.astro';
import profile from '../data/profile.json';
import services from '../data/services.json';
import { getCollection } from 'astro:content';

const workEntries = await getCollection('work');
const sortedWork = workEntries.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

// Structured data. The phone number is deliberately left out of public markup.
const siteHome = new URL(url('/'), Astro.site ?? 'https://sarojbaral.com.np').href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.headline,
    url: siteHome,
    email: profile.email,
    address: {
      '@type': 'PostalAddress',
      addressLocality: profile.location.city,
      addressCountry: profile.location.country,
    },
    sameAs: [profile.linkedin],
    description: profile.tagline,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Saroj Baral',
    url: siteHome,
    description: profile.headline,
  },
];
---

<BaseLayout
  title={`${profile.name}: ${profile.headline}`}
  description={`${profile.name}: ${profile.headline}. ${profile.tagline} Six years at Huawei Technologies Nepal, Executive MBA 2022, open to remote roles.`}
  jsonLd={jsonLd}
>
  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Stats strip -->
  <Stats />

  <!-- 3. Core services -->
  <section class="section" aria-labelledby="services-title">
    <div class="site-container">
      <div class="section-head" data-reveal>
        <div>
          <span class="eyebrow">What I do</span>
          <h2 id="services-title">Core services</h2>
          <p>
            Reporting systems, document control and cross-functional project tracking for teams that need dependable information before they make the next decision.
          </p>
        </div>
        <a href={url("/services")} class="link-arrow">
          All services <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="cards-auto">
        {services.map((service, i) => (
          <div data-reveal style={`--i:${i}`}>
            <ServiceSummary
              id={service.id}
              icon={service.icon}
              title={service.title}
              summary={service.summary}
              tags={service.tags}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Selected work -->
  <section class="section section--alt" aria-labelledby="work-title">
    <div class="site-container">
      <div class="section-head" data-reveal>
        <div>
          <span class="eyebrow">Selected work</span>
          <h2 id="work-title">Case studies</h2>
          <p>
            Worked examples built on dummy data. They show how I structure a reporting pack, a register or a tracker. They are samples of method, not client results.
          </p>
        </div>
        <a href={url("/work")} class="link-arrow">
          All case studies <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <div class="cards-auto">
        {sortedWork.map((entry, i) => (
          <div data-reveal style={`--i:${i}`}>
            <CaseStudyCard
              slug={entry.id}
              title={entry.data.title}
              summary={entry.data.summary}
              client_type={entry.data.client_type}
              year={entry.data.year}
              tools={entry.data.tools}
              result_metrics={entry.data.result_metrics}
              kpi={entry.data.kpi}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. More ways I help -->
  <section class="section" aria-labelledby="more-title" style="padding-block-end:0">
    <div class="site-container" data-reveal>
      <h2 id="more-title" class="sr-only">More ways I help</h2>
      <div class="card-base more">
        <div class="more__item">
          <span class="icon-tile"><Icon name="globe" size={22} /></span>
          <div>
            <h3>Simple business websites</h3>
            <p>Clean, fast, mobile-friendly sites for local businesses in 7 to 10 days. AI-assisted build, human-reviewed delivery.</p>
            <a href={url("/websites")} class="link-arrow stretched-link">
              See website packages <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
        <div class="more__item">
          <span class="icon-tile"><Icon name="graduation-cap" size={22} /></span>
          <div>
            <h3>Teaching &amp; workshops</h3>
            <p>Practical sessions on Excel for business, MIS, operations and project management, for teams and training programmes.</p>
            <a href={url("/teaching")} class="link-arrow stretched-link">
              Workshop details <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. Hire me -->
  <section class="section" aria-labelledby="hire-title">
    <div class="site-container" data-reveal>
      <div class="cta-banner">
        <div>
          <h2 id="hire-title">Hiring for a remote project or MIS role?</h2>
          <p>
            Open to remote roles in MIS, project control, data operations and project coordination. Based in Nepal (NPT, UTC+5:45), with working overlap for Gulf, European and Asia-Pacific hours.
          </p>
        </div>
        <div class="cta-banner__actions">
          <a href={`mailto:${profile.email}`} class="btn-base btn-light">
            <Icon name="mail" size={16} /> Email me
          </a>
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn-base btn-outline-light">
            <Icon name="linkedin" size={16} /> LinkedIn
          </a>
          <a href={url("/cv/Saroj-Baral-CV.pdf")} download="Saroj-Baral-CV.pdf" class="link-cta">
            Download CV <Icon name="download" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
