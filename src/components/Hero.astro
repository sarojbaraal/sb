---
import { url } from "../utils/url";
import profile from "../data/profile.json";
import CareerSchedule from "./CareerSchedule.astro";
---

<section class="pt-12 md:pt-20 pb-14 md:pb-20">
  <div class="site-container">
    <p class="text-[15px] text-[var(--color-muted)] mb-5 flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[var(--color-marigold)]" aria-hidden="true"></span>
      {profile.availability}. Working from {profile.location.country} on {profile.location.tzLabel}.
    </p>

    <h1 class="max-w-[15ch] md:max-w-[17ch] mb-6">
      Turning complex information into clear, useful decisions.
    </h1>

    <p class="text-lg md:text-xl text-[var(--color-muted)] prose-measure mb-8 leading-[1.6]">
      I bring together <strong class="text-[var(--color-text)]">MIS, business intelligence and project coordination</strong> to turn complex information into accurate reports, reliable records and better-informed decisions. My background includes six years at Huawei Technologies Nepal, an engineering degree, an Executive MBA and independent freelance work.
    </p>

    <div class="flex flex-wrap items-center gap-3 mb-14 md:mb-20">
      <a href={url("/cv")} class="btn-base btn-primary text-base px-5 py-2.5">View CV</a>
      <a href={`mailto:${profile.email}`} class="btn-base btn-secondary text-base px-5 py-2.5">Email me</a>
      <a href={url("/work")} class="link-quiet text-base ml-1">See sample work</a>
    </div>

    <CareerSchedule />
  </div>
</section>
